{
  "format": "mini-app-interface-v1",
  "name": "groove-basin",
  "interfaceVersion": 1,
  "appId": "wfg1r0qra2ewyvns05r0rddqttt57qxurz3nz5z95rjnm63et7e0",
  "packageId": "209d45cd3983bbab7ea52695c723fffe",
  "appVersion": "2016.06.25 (1.5.1+)",
  "status": "prototype-unqualified",
  "limits": {
    "bodyBytes": 1048576,
    "replyBytes": 4194304,
    "snapshotDocuments": 1000,
    "seconds": 120
  },
  "operations": {
    "audio.upload": {
      "description": "Import bounded audio bytes and return the updated music-library metadata.",
      "input": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,128}\\.(wav|mp3|ogg|flac)$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          },
          "contentBase64": {
            "type": "string",
            "contentEncoding": "base64",
            "maxLength": 1398104
          }
        },
        "required": [
          "filename",
          "sizeBytes",
          "contentBase64"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "array",
        "maxItems": 1000,
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "maxLength": 128
            },
            "name": {
              "type": "string",
              "maxLength": 4096
            },
            "artistName": {
              "type": "string",
              "maxLength": 4096
            },
            "albumName": {
              "type": "string",
              "maxLength": 4096
            },
            "file": {
              "type": "string",
              "format": "relative-path",
              "maxLength": 4096
            },
            "duration": {
              "type": "number"
            },
            "track": {
              "type": "integer"
            },
            "year": {
              "type": "integer"
            }
          },
          "required": [
            "key",
            "file",
            "name"
          ],
          "additionalProperties": true
        }
      },
      "write": true,
      "binding": {
        "protocol": "conversation",
        "wire": "json-v1",
        "path": [
          ""
        ],
        "steps": [
          {
            "id": "token",
            "receive": {
              "where": [
                {
                  "path": [
                    "name"
                  ],
                  "equals": "token"
                },
                {
                  "path": [
                    "args"
                  ],
                  "exists": true
                }
              ]
            }
          },
          {
            "id": "upload",
            "http": {
              "protocol": "http",
              "method": "POST",
              "path": [
                "upload"
              ],
              "cookies": {
                "token": {
                  "result": [
                    "token",
                    "args"
                  ]
                }
              },
              "multipart": [
                {
                  "name": "size",
                  "text": {
                    "concat": [
                      {
                        "arg": "sizeBytes"
                      }
                    ]
                  }
                },
                {
                  "name": "files",
                  "filename": {
                    "arg": "filename"
                  },
                  "contentType": "application/octet-stream",
                  "base64": {
                    "arg": "contentBase64"
                  }
                }
              ],
              "decode": "status",
              "status": [
                200
              ]
            }
          },
          {
            "send": {
              "name": "subscribe",
              "args": {
                "name": "library",
                "delta": false
              }
            }
          },
          {
            "id": "library",
            "receive": {
              "where": [
                {
                  "path": [
                    "name"
                  ],
                  "equals": "library"
                },
                {
                  "path": [
                    "args"
                  ],
                  "exists": true
                }
              ]
            }
          }
        ],
        "result": {
          "library": {
            "result": [
              "library",
              "args"
            ]
          }
        }
      },
      "projection": {
        "collection": "library",
        "where": {},
        "values": true
      }
    },
    "library.list": {
      "description": "Read the music library as structured track records.",
      "input": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "array",
        "maxItems": 1000,
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "maxLength": 128
            },
            "name": {
              "type": "string",
              "maxLength": 4096
            },
            "artistName": {
              "type": "string",
              "maxLength": 4096
            },
            "albumName": {
              "type": "string",
              "maxLength": 4096
            },
            "file": {
              "type": "string",
              "format": "relative-path",
              "maxLength": 4096
            },
            "duration": {
              "type": "number"
            },
            "track": {
              "type": "integer"
            },
            "year": {
              "type": "integer"
            }
          },
          "required": [
            "key",
            "file",
            "name"
          ],
          "additionalProperties": true
        }
      },
      "write": false,
      "binding": {
        "protocol": "conversation",
        "wire": "json-v1",
        "path": [
          ""
        ],
        "steps": [
          {
            "send": {
              "name": "subscribe",
              "args": {
                "name": "library",
                "delta": false
              }
            }
          },
          {
            "id": "library",
            "receive": {
              "where": [
                {
                  "path": [
                    "name"
                  ],
                  "equals": "library"
                },
                {
                  "path": [
                    "args"
                  ],
                  "exists": true
                }
              ]
            }
          }
        ],
        "result": {
          "library": {
            "result": [
              "library",
              "args"
            ]
          }
        }
      },
      "projection": {
        "collection": "library",
        "where": {},
        "values": true
      }
    },
    "audio.get": {
      "description": "Read exact bounded audio bytes for a library-relative track path.",
      "input": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "format": "relative-path",
            "maxLength": 4096
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "contentBase64": {
            "type": "string",
            "contentEncoding": "base64",
            "maxLength": 5592408
          }
        },
        "required": [
          "contentBase64"
        ],
        "additionalProperties": false
      },
      "write": false,
      "binding": {
        "protocol": "conversation",
        "wire": "json-v1",
        "path": [
          ""
        ],
        "steps": [
          {
            "id": "token",
            "receive": {
              "where": [
                {
                  "path": [
                    "name"
                  ],
                  "equals": "token"
                },
                {
                  "path": [
                    "args"
                  ],
                  "exists": true
                }
              ]
            }
          },
          {
            "id": "bytes",
            "http": {
              "protocol": "http",
              "method": "GET",
              "path": [
                "library/",
                {
                  "arg": "path",
                  "encoding": "path"
                }
              ],
              "decode": "base64",
              "status": [
                200
              ],
              "cookies": {
                "token": {
                  "result": [
                    "token",
                    "args"
                  ]
                }
              }
            }
          }
        ],
        "result": {
          "result": [
            "bytes"
          ]
        }
      }
    }
  },
  "qualification": [
    {
      "id": "upload",
      "op": "audio.upload",
      "args": {
        "filename": "mini-typed-tone.wav",
        "sizeBytes": 8126,
        "contentBase64": ""
      },
      "assert": [
        {
          "contains": {
            "name": "Mini Typed Tone"
          }
        }
      ]
    },
    {
      "id": "library",
      "op": "library.list",
      "args": {},
      "assert": [
        {
          "contains": {
            "name": "Mini Typed Tone"
          }
        }
      ]
    }
  ],
  "auth": {
    "kind": "member-session"
  },
  "sources": [
    "https://github.com/dwrensha/groovebasin/blob/c6a2cbda0b7a94971f9671a6b4955e1007470556/lib/server.js",
    "https://github.com/dwrensha/groovebasin/blob/c6a2cbda0b7a94971f9671a6b4955e1007470556/lib/player_server.js",
    "https://github.com/dwrensha/groovebasin/blob/c6a2cbda0b7a94971f9671a6b4955e1007470556/lib/web_socket_api_client.js"
  ],
  "$defs": {}
}
