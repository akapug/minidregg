{
  "type": "object",
  "properties": {
    "format": {
      "const": "mini-app-interface-v1"
    },
    "name": {
      "type": "string"
    },
    "interfaceVersion": {
      "type": "integer",
      "minimum": 1
    },
    "appId": {
      "type": "string",
      "pattern": "^[a-z0-9]{52}$"
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "appVersion": {
      "type": "string"
    },
    "status": {
      "const": "prototype-unqualified"
    },
    "limits": {
      "type": "object",
      "properties": {
        "bodyBytes": {
          "type": "integer",
          "minimum": 1
        },
        "replyBytes": {
          "type": "integer",
          "minimum": 1
        },
        "snapshotDocuments": {
          "type": "integer",
          "minimum": 1
        },
        "seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "bodyBytes",
        "replyBytes",
        "snapshotDocuments",
        "seconds"
      ],
      "additionalProperties": false
    },
    "$defs": {
      "type": "object"
    },
    "operations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "input": {
            "type": "object"
          },
          "output": {
            "type": "object"
          },
          "write": {
            "type": "boolean"
          },
          "binding": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "protocol": {
                    "const": "http"
                  },
                  "method": {
                    "enum": [
                      "GET",
                      "POST",
                      "PUT",
                      "PATCH",
                      "DELETE",
                      "HEAD",
                      "MKCOL",
                      "MOVE",
                      "PROPFIND",
                      "REPORT",
                      "MKCALENDAR"
                    ]
                  },
                  "path": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "arg": {
                              "type": "string"
                            },
                            "encoding": {
                              "enum": [
                                "path",
                                "segment"
                              ]
                            }
                          },
                          "required": [
                            "arg",
                            "encoding"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "decode": {
                    "enum": [
                      "json",
                      "base64",
                      "status",
                      "dav-multistatus",
                      "text",
                      "json-lines",
                      "caldav-multistatus",
                      "rss",
                      "json-string-fragment"
                    ]
                  },
                  "status": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 599
                    }
                  },
                  "headers": {
                    "type": "object"
                  },
                  "query": {
                    "type": "object"
                  },
                  "json": {
                    "type": "object"
                  },
                  "text": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object"
                      }
                    ]
                  },
                  "base64": {
                    "type": "object"
                  },
                  "form": {
                    "type": "object"
                  },
                  "multipart": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "filename": {
                          "oneOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "object"
                            }
                          ]
                        },
                        "contentType": {
                          "type": "string"
                        },
                        "text": {},
                        "base64": {}
                      },
                      "required": [
                        "name"
                      ],
                      "additionalProperties": false,
                      "oneOf": [
                        {
                          "required": [
                            "text"
                          ],
                          "not": {
                            "required": [
                              "base64"
                            ]
                          }
                        },
                        {
                          "required": [
                            "base64"
                          ],
                          "not": {
                            "required": [
                              "text"
                            ]
                          }
                        }
                      ]
                    }
                  },
                  "acceptedContentTypes": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "fragment": {
                    "type": "object",
                    "properties": {
                      "prefix": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "suffix": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      }
                    },
                    "required": [
                      "prefix",
                      "suffix"
                    ],
                    "additionalProperties": false
                  },
                  "responseHeaders": {
                    "type": "object",
                    "minProperties": 1,
                    "maxProperties": 8,
                    "propertyNames": {
                      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                    },
                    "additionalProperties": {
                      "enum": [
                        "etag",
                        "last-modified",
                        "content-type",
                        "content-length",
                        "x-sandstorm-app-data-version"
                      ]
                    }
                  },
                  "emptyValue": {}
                },
                "required": [
                  "protocol",
                  "method",
                  "path",
                  "decode",
                  "status"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "decode": {
                          "const": "json-string-fragment"
                        }
                      },
                      "required": [
                        "decode"
                      ]
                    },
                    "then": {
                      "required": [
                        "fragment"
                      ]
                    }
                  }
                ]
              },
              {
                "type": "object",
                "properties": {
                  "protocol": {
                    "const": "ddp"
                  },
                  "kind": {
                    "enum": [
                      "method",
                      "snapshot"
                    ]
                  },
                  "method": {
                    "type": "string"
                  },
                  "publication": {
                    "type": "string"
                  },
                  "params": {
                    "type": "array",
                    "items": {}
                  },
                  "collections": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "result": {
                    "enum": [
                      "insert-id",
                      "json"
                    ]
                  }
                },
                "required": [
                  "protocol",
                  "kind",
                  "params"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "method"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "method",
                        "result"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "snapshot"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "publication",
                        "collections"
                      ]
                    }
                  }
                ]
              }
            ]
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string"
                },
                "args": {
                  "type": "object"
                },
                "exists": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "collection": {
                        "type": "string"
                      },
                      "where": {
                        "type": "object",
                        "minProperties": 1
                      }
                    },
                    "required": [
                      "collection",
                      "where"
                    ],
                    "additionalProperties": false
                  }
                },
                "assert": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "array",
                        "items": {
                          "type": [
                            "string",
                            "integer"
                          ]
                        }
                      },
                      "equals": {}
                    },
                    "required": [
                      "path",
                      "equals"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "op",
                "args"
              ],
              "additionalProperties": false,
              "anyOf": [
                {
                  "required": [
                    "exists"
                  ]
                },
                {
                  "required": [
                    "assert"
                  ]
                }
              ]
            }
          },
          "projection": {
            "type": "object",
            "properties": {
              "collection": {
                "type": "string"
              },
              "where": {
                "type": "object"
              },
              "values": {
                "type": "boolean"
              }
            },
            "required": [
              "collection",
              "where"
            ],
            "additionalProperties": false
          },
          "internal": {
            "type": "boolean"
          },
          "prepare": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "op": {
                  "type": "string"
                },
                "args": {
                  "type": "object"
                }
              },
              "required": [
                "id",
                "op",
                "args"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "description",
          "input",
          "output",
          "write",
          "binding"
        ],
        "additionalProperties": false
      }
    },
    "qualification": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "op": {
            "type": "string"
          },
          "args": {
            "type": "object"
          },
          "assert": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "await": {
            "type": "object",
            "properties": {
              "attempts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "intervalSeconds": {
                "type": "number",
                "minimum": 0,
                "maximum": 3
              },
              "retryStatuses": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 3,
                "items": {
                  "enum": [
                    502,
                    503,
                    504
                  ]
                }
              }
            },
            "required": [
              "attempts",
              "intervalSeconds",
              "retryStatuses"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "op",
          "args"
        ],
        "additionalProperties": false
      }
    },
    "auth": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "format",
    "name",
    "interfaceVersion",
    "appId",
    "packageId",
    "appVersion",
    "status",
    "limits",
    "$defs",
    "operations",
    "qualification",
    "auth",
    "sources"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
