{
  "format": "mini-app-interface-v1",
  "name": "kiwix",
  "interfaceVersion": 1,
  "appId": "5uh349d0kky2zp5whrh2znahn27gwha876xze3864n0fu9e5220h",
  "packageId": "eace6915b227131cf0ed2b1a0db2e86b",
  "appVersion": "0.1.0",
  "status": "prototype-unqualified",
  "limits": {
    "bodyBytes": 1048576,
    "replyBytes": 4194304,
    "snapshotDocuments": 1000,
    "seconds": 120
  },
  "operations": {
    "library.upload": {
      "description": "Import one bounded ZIM archive into an empty library; a completed library cannot be overwritten.",
      "input": {
        "type": "object",
        "properties": {
          "contentBase64": {
            "type": "string",
            "contentEncoding": "base64",
            "maxLength": 1398104
          },
          "contentRange": {
            "type": "string",
            "pattern": "^bytes [0-9]+-[0-9]+/[0-9]+$"
          }
        },
        "required": [
          "contentBase64",
          "contentRange"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 4096
                },
                "type": {
                  "type": "string",
                  "maxLength": 4096
                },
                "size": {
                  "type": "integer"
                },
                "total_size": {
                  "type": "integer"
                }
              },
              "required": [
                "name",
                "size",
                "total_size"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "files"
        ],
        "additionalProperties": false
      },
      "write": true,
      "binding": {
        "protocol": "http",
        "method": "POST",
        "path": [
          "upload"
        ],
        "decode": "json",
        "status": [
          200
        ],
        "multipart": [
          {
            "name": "contentRange",
            "text": {
              "arg": "contentRange"
            }
          },
          {
            "name": "file",
            "filename": "library.zim",
            "contentType": "application/octet-stream",
            "base64": {
              "arg": "contentBase64"
            }
          }
        ],
        "acceptedContentTypes": [
          "text/html"
        ]
      }
    },
    "article.get": {
      "description": "Read a finite article resource from the imported library.",
      "input": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "format": "relative-path",
            "maxLength": 1024
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "string",
        "maxLength": 4194304
      },
      "write": false,
      "binding": {
        "protocol": "http",
        "method": "GET",
        "path": [
          "kiwix/",
          {
            "arg": "path",
            "encoding": "path"
          }
        ],
        "decode": "text",
        "status": [
          200
        ]
      }
    }
  },
  "qualification": [
    {
      "id": "upload",
      "op": "library.upload",
      "args": {
        "contentBase64": "",
        "contentRange": "bytes 0-654/655"
      }
    },
    {
      "id": "article",
      "op": "article.get",
      "args": {
        "path": "A/Hello"
      },
      "assert": [
        {
          "path": [],
          "containsText": "Mini native typed library"
        }
      ]
    }
  ],
  "auth": {
    "kind": "member-session"
  },
  "sources": [
    "package:eace6915b227131cf0ed2b1a0db2e86b/zim_uploader/uploader/app.py",
    "https://github.com/orblivion/KiwixSandstorm/blob/master/package/zim_uploader/uploader/app.py",
    "scripts/spk-platform/market-writes/b5-mkzim.py"
  ],
  "$defs": {}
}
