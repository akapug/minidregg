{
  "format": "mini-app-interface-v1",
  "name": "revealjs",
  "interfaceVersion": 1,
  "appId": "vku2z06we4n4cfpvn28y6159fsgft9nttvvfeg1wndu8szvrtm3h",
  "packageId": "667f3752d4a28a084a26eb09ac55e9ea",
  "appVersion": "6.0.2",
  "status": "prototype-unqualified",
  "limits": {
    "bodyBytes": 1048576,
    "replyBytes": 1048576,
    "snapshotDocuments": 1000,
    "seconds": 120
  },
  "operations": {
    "deck.replace": {
      "description": "Replace the deck's markdown source. The grain keeps one deck at /var/deck.md; the web root renders it, so this is a full replacement, not a per-slide patch.",
      "input": {
        "type": "object",
        "properties": {
          "markdown": {
            "type": "string",
            "maxLength": 1048576
          }
        },
        "required": [
          "markdown"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "write": true,
      "binding": {
        "protocol": "http",
        "method": "PUT",
        "path": [
          "deck.md"
        ],
        "decode": "status",
        "status": [
          204
        ],
        "text": {
          "arg": "markdown"
        },
        "headers": {
          "content-type": "text/markdown"
        }
      }
    },
    "deck.read": {
      "description": "Read the exact markdown source last written, slide separators included; rendered layout is not represented.",
      "input": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "string",
        "maxLength": 1048576
      },
      "write": false,
      "binding": {
        "protocol": "http",
        "method": "GET",
        "path": [
          "deck.md"
        ],
        "decode": "text",
        "status": [
          200
        ]
      }
    }
  },
  "qualification": [
    {
      "id": "write",
      "op": "deck.replace",
      "args": {
        "markdown": "# Mini typed deck\n\n---\n\n## Slide two\n"
      }
    },
    {
      "id": "read",
      "op": "deck.read",
      "args": {},
      "assert": [
        {
          "path": [],
          "equals": "# Mini typed deck\n\n---\n\n## Slide two\n"
        }
      ]
    }
  ],
  "auth": {
    "kind": "member-route"
  },
  "sources": [
    "https://github.com/hakimel/reveal.js/releases/tag/6.0.2",
    "package:667f3752d4a28a084a26eb09ac55e9ea/opt/app/server.js"
  ],
  "$defs": {}
}
