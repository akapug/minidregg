{
  "format": "mini-app-interface-v1",
  "name": "ipython-notebook",
  "interfaceVersion": 1,
  "appId": "rprqf3t2h3vd3swfkhwk076qrennh9msreyjv70g7sgw5hkdxjph",
  "packageId": "57dedad4b0275606c24bdb13d995b218",
  "appVersion": "4.2.2",
  "status": "prototype-unqualified",
  "limits": {
    "bodyBytes": 1048576,
    "replyBytes": 4194304,
    "snapshotDocuments": 1000,
    "seconds": 120
  },
  "operations": {
    "contents.get": {
      "description": "Read a notebook, file, or directory using the browser\u2019s Contents API.",
      "input": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 1024,
            "format": "relative-path"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "output": {
        "$ref": "#/$defs/ContentModel"
      },
      "write": false,
      "binding": {
        "protocol": "http",
        "method": "GET",
        "path": [
          "api/contents/",
          {
            "arg": "path",
            "encoding": "path"
          }
        ],
        "decode": "json",
        "status": [
          200
        ],
        "query": {
          "content": "1"
        }
      }
    },
    "notebook.put": {
      "description": "Save a notebook document with typed cells and recorded outputs; saving does not execute code.",
      "input": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 1024,
            "format": "relative-path"
          },
          "notebook": {
            "type": "object",
            "properties": {
              "nbformat": {
                "const": 4
              },
              "nbformat_minor": {
                "type": "integer",
                "minimum": 0
              },
              "metadata": {
                "type": "object"
              },
              "cells": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "type": "object",
                  "properties": {
                    "cell_type": {
                      "enum": [
                        "code",
                        "markdown",
                        "raw"
                      ]
                    },
                    "source": {
                      "oneOf": [
                        {
                          "type": "string",
                          "maxLength": 1048576
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "maxLength": 4096
                          }
                        }
                      ]
                    },
                    "metadata": {
                      "type": "object"
                    },
                    "execution_count": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "outputs": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  },
                  "required": [
                    "cell_type",
                    "source",
                    "metadata"
                  ],
                  "additionalProperties": true
                }
              }
            },
            "required": [
              "nbformat",
              "nbformat_minor",
              "metadata",
              "cells"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "path",
          "notebook"
        ],
        "additionalProperties": false
      },
      "output": {
        "$ref": "#/$defs/ContentModel"
      },
      "write": true,
      "binding": {
        "protocol": "http",
        "method": "PUT",
        "path": [
          "api/contents/",
          {
            "arg": "path",
            "encoding": "path"
          }
        ],
        "decode": "json",
        "status": [
          200,
          201
        ],
        "json": {
          "type": "notebook",
          "content": {
            "arg": "notebook"
          }
        }
      }
    },
    "file.put": {
      "description": "Save UTF-8 file text through the same Contents API used by the browser.",
      "input": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 1024,
            "format": "relative-path"
          },
          "text": {
            "type": "string",
            "maxLength": 1048576
          }
        },
        "required": [
          "path",
          "text"
        ],
        "additionalProperties": false
      },
      "output": {
        "$ref": "#/$defs/ContentModel"
      },
      "write": true,
      "binding": {
        "protocol": "http",
        "method": "PUT",
        "path": [
          "api/contents/",
          {
            "arg": "path",
            "encoding": "path"
          }
        ],
        "decode": "json",
        "status": [
          200,
          201
        ],
        "json": {
          "type": "file",
          "format": "text",
          "content": {
            "arg": "text"
          }
        }
      }
    },
    "contents.delete": {
      "description": "Delete a notebook, file, or empty directory.",
      "input": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 1024,
            "format": "relative-path"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "write": true,
      "binding": {
        "protocol": "http",
        "method": "DELETE",
        "path": [
          "api/contents/",
          {
            "arg": "path",
            "encoding": "path"
          }
        ],
        "decode": "status",
        "status": [
          204
        ]
      }
    },
    "kernels.list": {
      "description": "List running kernels without starting or executing one.",
      "input": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 4096
            },
            "name": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": true
        }
      },
      "write": false,
      "binding": {
        "protocol": "http",
        "method": "GET",
        "path": [
          "api/kernels"
        ],
        "decode": "json",
        "status": [
          200
        ]
      }
    },
    "kernels.start": {
      "description": "Start a named computation kernel; execution requires a separately supported channels protocol.",
      "input": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 4096
          },
          "name": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": true
      },
      "write": true,
      "binding": {
        "protocol": "http",
        "method": "POST",
        "path": [
          "api/kernels"
        ],
        "decode": "json",
        "status": [
          201
        ],
        "json": {
          "name": {
            "arg": "name"
          }
        }
      }
    },
    "kernels.stop": {
      "description": "Stop a running kernel and release its resources.",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "write": true,
      "binding": {
        "protocol": "http",
        "method": "DELETE",
        "path": [
          "api/kernels/",
          {
            "arg": "id",
            "encoding": "segment"
          }
        ],
        "decode": "status",
        "status": [
          204
        ]
      }
    },
    "contents.root": {
      "description": "List notebooks, files and directories at the browser\u2019s root.",
      "input": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "$ref": "#/$defs/ContentModel"
      },
      "write": false,
      "binding": {
        "protocol": "http",
        "method": "GET",
        "path": [
          "api/contents"
        ],
        "decode": "json",
        "status": [
          200
        ],
        "query": {
          "content": "1"
        }
      }
    }
  },
  "qualification": [
    {
      "id": "put",
      "op": "notebook.put",
      "args": {
        "path": {
          "concat": [
            {
              "context": "runId"
            },
            ".ipynb"
          ]
        },
        "notebook": {
          "nbformat": 4,
          "nbformat_minor": 0,
          "metadata": {},
          "cells": [
            {
              "cell_type": "markdown",
              "source": "Mini typed notebook",
              "metadata": {}
            }
          ]
        }
      }
    },
    {
      "id": "get",
      "op": "contents.get",
      "args": {
        "path": {
          "concat": [
            {
              "context": "runId"
            },
            ".ipynb"
          ]
        }
      },
      "assert": [
        {
          "path": [
            "content",
            "cells",
            0,
            "source"
          ],
          "equals": "Mini typed notebook"
        }
      ]
    }
  ],
  "auth": {
    "kind": "member-session"
  },
  "sources": [
    "https://github.com/jupyter/notebook/blob/4.2.2/notebook/services/contents/handlers.py",
    "https://github.com/jupyter/notebook/blob/4.2.2/notebook/services/kernels/handlers.py",
    "scripts/spk-platform/market-writes/b8.sh"
  ],
  "$defs": {
    "ContentModel": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 1024
        },
        "path": {
          "type": "string",
          "maxLength": 1024
        },
        "type": {
          "enum": [
            "notebook",
            "file",
            "directory"
          ]
        },
        "content": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "nbformat": {
                  "const": 4
                },
                "nbformat_minor": {
                  "type": "integer",
                  "minimum": 0
                },
                "metadata": {
                  "type": "object"
                },
                "cells": {
                  "type": "array",
                  "maxItems": 1000,
                  "items": {
                    "type": "object",
                    "properties": {
                      "cell_type": {
                        "enum": [
                          "code",
                          "markdown",
                          "raw"
                        ]
                      },
                      "source": {
                        "oneOf": [
                          {
                            "type": "string",
                            "maxLength": 1048576
                          },
                          {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "maxLength": 4096
                            }
                          }
                        ]
                      },
                      "metadata": {
                        "type": "object"
                      },
                      "execution_count": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "outputs": {
                        "type": "array",
                        "items": {
                          "type": "object"
                        }
                      }
                    },
                    "required": [
                      "cell_type",
                      "source",
                      "metadata"
                    ],
                    "additionalProperties": true
                  }
                }
              },
              "required": [
                "nbformat",
                "nbformat_minor",
                "metadata",
                "cells"
              ],
              "additionalProperties": false
            },
            {
              "type": "string"
            },
            {
              "type": "array",
              "maxItems": 10000,
              "items": {
                "$ref": "#/$defs/ContentModel"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "format": {
          "type": [
            "string",
            "null"
          ]
        },
        "mimetype": {
          "type": [
            "string",
            "null"
          ]
        },
        "created": {
          "type": "string",
          "maxLength": 4096
        },
        "last_modified": {
          "type": "string",
          "maxLength": 4096
        },
        "writable": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "path",
        "type",
        "content",
        "format"
      ],
      "additionalProperties": true
    }
  }
}
