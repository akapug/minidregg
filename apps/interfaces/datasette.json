{
  "format": "mini-app-interface-v1",
  "name": "datasette",
  "interfaceVersion": 1,
  "appId": "f3s5vv8g7xuay08e3x1g5zwuaycz0mt7170nmz3kf5e1g1q9ytr0",
  "packageId": "daafe47b15e9c8659cff5236746e5506",
  "appVersion": "0.65.5",
  "status": "prototype-unqualified",
  "limits": {
    "bodyBytes": 1048576,
    "replyBytes": 4194304,
    "snapshotDocuments": 1000,
    "seconds": 120
  },
  "operations": {
    "versions.read": {
      "description": "Read the Datasette version and runtime version inventory.",
      "input": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "datasette": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string"
              }
            },
            "required": [
              "version"
            ]
          }
        },
        "required": [
          "datasette"
        ]
      },
      "write": false,
      "binding": {
        "protocol": "http",
        "method": "GET",
        "path": [
          "-/versions.json"
        ],
        "decode": "json",
        "status": [
          200
        ]
      }
    },
    "sql.query": {
      "description": "Run a read-only SQLite SQL query and return typed objects; Datasette enforces its SQL rules.",
      "input": {
        "type": "object",
        "properties": {
          "database": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          },
          "sql": {
            "type": "string",
            "maxLength": 16384
          }
        },
        "required": [
          "database",
          "sql"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "array",
        "maxItems": 1000,
        "items": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      },
      "write": false,
      "binding": {
        "protocol": "http",
        "method": "GET",
        "path": [
          {
            "arg": "database",
            "encoding": "segment"
          },
          ".json"
        ],
        "decode": "json",
        "status": [
          200
        ],
        "query": {
          "sql": {
            "arg": "sql"
          },
          "_shape": "array",
          "_size": "1000"
        }
      },
      "projection": {
        "collection": "rows",
        "where": {}
      }
    },
    "databases.list": {
      "description": "List databases currently available to this member’s grain.",
      "input": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "array",
        "items": {
          "type": "object"
        },
        "maxItems": 1000
      },
      "write": false,
      "binding": {
        "protocol": "http",
        "method": "GET",
        "path": [
          "-/databases.json"
        ],
        "decode": "json",
        "status": [
          200
        ]
      }
    }
  },
  "qualification": [
    {
      "id": "versions",
      "op": "versions.read",
      "args": {},
      "assert": [
        {
          "path": [
            "datasette",
            "version"
          ],
          "equals": "0.65.5"
        }
      ]
    },
    {
      "id": "databases",
      "op": "databases.list",
      "args": {}
    }
  ],
  "auth": {
    "kind": "member-session",
    "appCookies": "retain"
  },
  "sources": [
    "https://github.com/simonw/datasette/blob/0.65.5/datasette/app.py",
    "package:daafe47b15e9c8659cff5236746e5506/opt/app/venv/lib/python3.13/site-packages/datasette/app.py",
    "package:daafe47b15e9c8659cff5236746e5506/opt/app/venv/lib/python3.13/site-packages/datasette_sandstorm_support/__init__.py"
  ],
  "$defs": {}
}
