        }
      }
    },
    {
      "id": "read",
      "op": "account.list",
      "args": {
        "page": 1
      },
      "assert": [
        {
          "path": [
            "data",
            0,
            "attributes",
            "name"
          ],
          "equals": {
            "context": "runId"
          }
        }
      ]
