{
  "format": "mini-app-interface-v1",
  "name": "linksholder",
  "interfaceVersion": 1,
  "appId": "upcmp5j10r4x8j7kdfram8xx41ujvqjw0hq8ed2y72hky552znk0",
  "packageId": "d11845a484a0a03767676c3c31c032e6",
  "appVersion": "2017.03.10.0",
  "status": "prototype-unqualified",
  "limits": {
    "bodyBytes": 16384,
    "replyBytes": 1048576,
    "snapshotDocuments": 1000,
    "seconds": 120
  },
  "$defs": {},
  "operations": {
    "link.append": {
      "description": "Append a link row to the exact sheet1 directory browsed by the human UI. CSV quoting preserves commas/quotes/newlines; do not replace the directory. Titles starting with comment marker are refused because the package hides those rows. No deduplication or automatic replay after uncertain append.",
      "input": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https?://[^\\r\\n\\x00 ]+$",
            "maxLength": 2048
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[^#][\\s\\S]*$"
          }
        },
        "required": [
          "url",
          "title"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "write": true,
      "binding": {
        "protocol": "http",
        "method": "POST",
        "path": [
          "_/sheet1"
        ],
        "decode": "status",
        "status": [
          202
        ],
        "headers": {
          "content-type": "text/csv; charset=utf-8"
        },
        "text": {
          "csv": [
            [
              {
                "arg": "url"
              },
              {
                "arg": "title"
              },
              "",
              ""
            ]
          ]
        }
      }
    },
    "links.rows.read": {
      "description": "Read bounded complete rows of the human link directory. Columns URL, title, display mode and labels retain package meaning; heading/comment rows remain visible as data. No filtered query or pagination protocol is claimed.",
      "input": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "array",
        "maxItems": 1000,
        "items": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string",
            "maxLength": 8192
          }
        }
      },
      "write": false,
      "binding": {
        "protocol": "http",
        "method": "GET",
        "path": [
          "_/sheet1/csv.json"
        ],
        "decode": "json",
        "status": [
          200
        ]
      }
    }
  },
  "qualification": [
    {
      "id": "append",
      "op": "link.append",
      "args": {
        "url": {
          "concat": [
            "https://example.invalid/",
            {
              "context": "runId"
            }
          ]
        },
        "title": {
          "concat": [
            "Typed, quoted \"link\" ",
            {
              "context": "runId"
            }
          ]
        }
      }
    },
    {
      "id": "read",
      "op": "links.rows.read",
      "args": {},
      "assert": [
        {
          "contains": [
            {
              "concat": [
                "https://example.invalid/",
                {
                  "context": "runId"
                }
              ]
            },
            {
              "concat": [
                "Typed, quoted \"link\" ",
                {
                  "context": "runId"
                }
              ]
            },
            "",
            ""
          ]
        }
      ]
    }
  ],
  "auth": {
    "kind": "member-route"
  },
  "sources": [
    "https://github.com/PDIS/ethercalc/tree/sandstorm-linksholder",
    "package:d11845a484a0a03767676c3c31c032e6/opt/app/main.js",
    "package:d11845a484a0a03767676c3c31c032e6/opt/app/hackfoldr/js/index.js"
  ]
}
