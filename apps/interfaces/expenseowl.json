    "https://github.com/ocdtrekkie/ExpenseOwl",
    "scripts/spk-platform/market-writes/b2.sh",
    "https://github.com/ocdtrekkie/ExpenseOwl/blob/main/internal/api/handlers.go",
    "https://github.com/ocdtrekkie/ExpenseOwl/blob/main/internal/config/config.go"
  ],
  "$defs": {}
}
