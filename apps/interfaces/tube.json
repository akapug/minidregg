{
  "format": "mini-app-interface-v1",
  "name": "tube",
  "interfaceVersion": 1,
  "appId": "70xjeuj6t85v3s9a3up583q97wu044mnt8aekf3pqs41e3ct2v70",
  "packageId": "cbba85a45618c184f304d90ccce303a9",
  "appVersion": "1.1.13",
  "status": "prototype-unqualified",
  "limits": {
    "bodyBytes": 1048576,
    "replyBytes": 4194304,
    "snapshotDocuments": 1000,
    "seconds": 120
  },
  "operations": {
    "video.upload": {
      "description": "Upload a bounded video with title and description; the app transcodes it into the browser\u2019s video library.",
      "input": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 1024
          },
          "description": {
            "type": "string",
            "maxLength": 16384
          },
          "contentBase64": {
            "type": "string",
            "contentEncoding": "base64",
            "maxLength": 1398104
          }
        },
        "required": [
          "title",
          "description",
          "contentBase64"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "write": true,
      "binding": {
        "protocol": "http",
        "method": "POST",
        "path": [
          "upload"
        ],
        "decode": "status",
        "status": [
          200
        ],
        "multipart": [
          {
            "name": "video_title",
            "text": {
              "arg": "title"
            }
          },
          {
            "name": "video_description",
            "text": {
              "arg": "description"
            }
          },
          {
            "name": "video_file",
            "filename": "video.mp4",
            "contentType": "video/mp4",
            "base64": {
              "arg": "contentBase64"
            }
          }
        ]
      }
    },
    "videos.list": {
      "description": "Read the library\u2019s RSS data feed as typed metadata and media enclosure references.",
      "input": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "array",
        "maxItems": 1000,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 4096
            },
            "title": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 16384
            },
            "link": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 16384
            },
            "description": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 16384
            },
            "published": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 16384
            },
            "enclosure": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "maxLength": 4096
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "type": {
                      "type": "string",
                      "maxLength": 128
                    }
                  },
                  "required": [
                    "url",
                    "bytes",
                    "type"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "id",
            "title",
            "link",
            "description",
            "published",
            "enclosure"
          ],
          "additionalProperties": false
        }
      },
      "write": false,
      "binding": {
        "protocol": "http",
        "method": "GET",
        "path": [
          "feed.xml"
        ],
        "decode": "rss",
        "status": [
          200
        ]
      }
    },
    "video.get": {
      "description": "Read bounded MP4 bytes using the video ID from a library /v/<id> link, optionally including its collection prefix.",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "relative-path",
            "maxLength": 512
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "contentBase64": {
            "type": "string",
            "contentEncoding": "base64",
            "maxLength": 5592408
          }
        },
        "required": [
          "contentBase64"
        ],
        "additionalProperties": false
      },
      "write": false,
      "binding": {
        "protocol": "http",
        "method": "GET",
        "path": [
          "v/",
          {
            "arg": "id",
            "encoding": "path"
          },
          ".mp4"
        ],
        "decode": "base64",
        "status": [
          200
        ]
      }
    },
    "thumbnail.get": {
      "description": "Read the generated thumbnail bytes for a video ID.",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "relative-path",
            "maxLength": 512
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "contentBase64": {
            "type": "string",
            "contentEncoding": "base64",
            "maxLength": 5592408
          }
        },
        "required": [
          "contentBase64"
        ],
        "additionalProperties": false
      },
      "write": false,
      "binding": {
        "protocol": "http",
        "method": "GET",
        "path": [
          "t/",
          {
            "arg": "id",
            "encoding": "path"
          }
        ],
        "decode": "base64",
        "status": [
          200
        ]
      }
    }
  },
  "qualification": [
    {
      "id": "upload",
      "op": "video.upload",
      "args": {
        "title": {
          "context": "runId"
        },
        "description": "Uploaded through the member\u2019s typed video tool.",
        "contentBase64": ""
      }
    },
    {
      "id": "feed",
      "op": "videos.list",
      "args": {},
      "await": {
        "attempts": 20,
        "intervalSeconds": 3,
        "retryStatuses": [
          502,
          503
        ]
      },
      "assert": [
        {
          "contains": {
            "title": {
              "context": "runId"
            },
            "description": "Uploaded through the member\u2019s typed video tool."
          }
        }
      ]
    }
  ],
  "auth": {
    "kind": "member-session"
  },
  "sources": [
    "https://git.mills.io/prologic/tube/src/commit/cc036e0af183a1504546f796949d732ea5cfe045/app/app.go",
    "https://git.mills.io/prologic/tube/src/commit/cc036e0af183a1504546f796949d732ea5cfe045/app/feed.go",
    "scripts/spk-platform/market-writes/b5-tube-clip.py"
  ],
  "$defs": {}
}
