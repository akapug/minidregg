{
  "format": "mini-app-interface-v1",
  "name": "wordpress",
  "interfaceVersion": 1,
  "appId": "aax9j672p6z8n7nyupzvj2nmumeqd4upa0f7mgu8gprwmy53x04h",
  "packageId": "d6955e8f377ac431db17fd01855b3ce5",
  "appVersion": "v2023.03.02 (4.9.8)",
  "status": "prototype-unqualified",
  "limits": {
    "bodyBytes": 16384,
    "replyBytes": 1048576,
    "snapshotDocuments": 1000,
    "seconds": 120
  },
  "$defs": {},
  "operations": {
    "site.initialize": {
      "description": "Initialize fresh WordPress database through the package modified installer, using routed member identity. This GET mutates the grain. Existing installation redirects; never replay an uncertain initialization.",
      "input": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "write": true,
      "binding": {
        "protocol": "http",
        "method": "GET",
        "path": [
          "wp-admin/install.php"
        ],
        "decode": "status",
        "status": [
          200,
          302,
          303
        ]
      }
    },
    "member.read": {
      "description": "Use only the Mini route cookie: package auto_login maps current signed Sandstorm permissions on each request. App auth cookies would skip that role mapping and require REST nonce.",
      "input": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "slug": {
            "type": "string",
            "maxLength": 255
          }
        },
        "required": [
          "id",
          "name",
          "slug"
        ],
        "additionalProperties": true
      },
      "write": false,
      "binding": {
        "protocol": "http",
        "method": "GET",
        "path": [],
        "decode": "json",
        "status": [
          200
        ],
        "query": {
          "rest_route": "/wp/v2/users/me",
          "context": "edit"
        }
      }
    },
    "post.create": {
      "description": "Create a draft post in this member grain. Does not publish. Use only the Mini route cookie: package auto_login maps current signed Sandstorm permissions on each request. App auth cookies would skip that role mapping and require REST nonce.",
      "input": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 1024
          },
          "content": {
            "type": "string",
            "maxLength": 8192
          }
        },
        "required": [
          "title",
          "content"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "draft",
              "publish",
              "pending",
              "private",
              "future"
            ]
          },
          "title": {
            "type": "object",
            "properties": {
              "raw": {
                "type": "string",
                "maxLength": 8192
              }
            },
            "required": [
              "raw"
            ],
            "additionalProperties": true
          },
          "content": {
            "type": "object",
            "properties": {
              "raw": {
                "type": "string",
                "maxLength": 1048576
              }
            },
            "required": [
              "raw"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "id",
          "status",
          "title",
          "content"
        ],
        "additionalProperties": true
      },
      "write": true,
      "binding": {
        "protocol": "http",
        "method": "POST",
        "path": [],
        "decode": "json",
        "status": [
          201
        ],
        "query": {
          "rest_route": "/wp/v2/posts",
          "context": "edit"
        },
        "json": {
          "title": {
            "arg": "title"
          },
          "content": {
            "arg": "content"
          },
          "status": "draft"
        }
      }
    },
    "post.read": {
      "description": "Read editable raw post fields by grain-scoped post ID. Requires app edit permission as well as Mini authority.",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "draft",
              "publish",
              "pending",
              "private",
              "future"
            ]
          },
          "title": {
            "type": "object",
            "properties": {
              "raw": {
                "type": "string",
                "maxLength": 8192
              }
            },
            "required": [
              "raw"
            ],
            "additionalProperties": true
          },
          "content": {
            "type": "object",
            "properties": {
              "raw": {
                "type": "string",
                "maxLength": 1048576
              }
            },
            "required": [
              "raw"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "id",
          "status",
          "title",
          "content"
        ],
        "additionalProperties": true
      },
      "write": false,
      "binding": {
        "protocol": "http",
        "method": "GET",
        "path": [],
        "decode": "json",
        "status": [
          200
        ],
        "query": {
          "rest_route": {
            "concat": [
              "/wp/v2/posts/",
              {
                "arg": "id"
              }
            ]
          },
          "context": "edit"
        }
      }
    },
    "post.update": {
      "description": "Replace editable title/content; WordPress4.9.8 has no declared atomic revision precondition here, so concurrent edits may be overwritten. Post ID is scoped to this grain. Do not retry uncertain completion.",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "maxLength": 1024
          },
          "content": {
            "type": "string",
            "maxLength": 8192
          }
        },
        "required": [
          "id",
          "title",
          "content"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "draft",
              "publish",
              "pending",
              "private",
              "future"
            ]
          },
          "title": {
            "type": "object",
            "properties": {
              "raw": {
                "type": "string",
                "maxLength": 8192
              }
            },
            "required": [
              "raw"
            ],
            "additionalProperties": true
          },
          "content": {
            "type": "object",
            "properties": {
              "raw": {
                "type": "string",
                "maxLength": 1048576
              }
            },
            "required": [
              "raw"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "id",
          "status",
          "title",
          "content"
        ],
        "additionalProperties": true
      },
      "write": true,
      "binding": {
        "protocol": "http",
        "method": "POST",
        "path": [],
        "decode": "json",
        "status": [
          200
        ],
        "query": {
          "rest_route": {
            "concat": [
              "/wp/v2/posts/",
              {
                "arg": "id"
              }
            ]
          },
          "context": "edit"
        },
        "json": {
          "title": {
            "arg": "title"
          },
          "content": {
            "arg": "content"
          }
        }
      }
    },
    "post.list": {
      "description": "List one bounded page of posts by status and text search. Page is 1-based; perPage is 1..100. Empty filtered first page is []; WordPress4.9.8 refuses pages beyond the last page rather than promising empty output. No stable snapshot across pages.",
      "input": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "perPage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "status": {
            "enum": [
              "draft",
              "publish",
              "pending",
              "private",
              "future"
            ]
          },
          "search": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "required": [
          "page",
          "perPage",
          "status",
          "search"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "status": {
              "enum": [
                "draft",
                "publish",
                "pending",
                "private",
                "future"
              ]
            },
            "title": {
              "type": "object",
              "properties": {
                "raw": {
                  "type": "string",
                  "maxLength": 8192
                }
              },
              "required": [
                "raw"
              ],
              "additionalProperties": true
            },
            "content": {
              "type": "object",
              "properties": {
                "raw": {
                  "type": "string",
                  "maxLength": 1048576
                }
              },
              "required": [
                "raw"
              ],
              "additionalProperties": true
            }
          },
          "required": [
            "id",
            "status",
            "title",
            "content"
          ],
          "additionalProperties": true
        }
      },
      "write": false,
      "binding": {
        "protocol": "http",
        "method": "GET",
        "path": [],
        "decode": "json",
        "status": [
          200
        ],
        "query": {
          "rest_route": "/wp/v2/posts",
          "context": "edit",
          "page": {
            "arg": "page"
          },
          "per_page": {
            "arg": "perPage"
          },
          "status": {
            "arg": "status"
          },
          "search": {
            "arg": "search"
          }
        }
      }
    }
  },
  "qualification": [
    {
      "id": "initialize",
      "op": "site.initialize",
      "args": {}
    },
    {
      "id": "member",
      "op": "member.read",
      "args": {}
    },
    {
      "id": "draft",
      "op": "post.create",
      "args": {
        "title": {
          "context": "runId"
        },
        "content": "Typed draft initial"
      }
    },
    {
      "id": "read",
      "op": "post.read",
      "args": {
        "id": {
          "result": [
            "draft",
            "id"
          ]
        }
      },
      "assert": [
        {
          "path": [
            "content",
            "raw"
          ],
          "equals": "Typed draft initial"
        }
      ]
    },
    {
      "id": "update",
      "op": "post.update",
      "args": {
        "id": {
          "result": [
            "draft",
            "id"
          ]
        },
        "title": {
          "context": "runId"
        },
        "content": "Typed draft revised"
      }
    },
    {
      "id": "readback",
      "op": "post.read",
      "args": {
        "id": {
          "result": [
            "draft",
            "id"
          ]
        }
      },
      "assert": [
        {
          "path": [
            "content",
            "raw"
          ],
          "equals": "Typed draft revised"
        },
        {
          "path": [
            "status"
          ],
          "equals": "draft"
        }
      ]
    }
  ],
  "auth": {
    "kind": "member-route",
    "appCookies": "omit"
  },
  "sources": [
    "https://github.com/sandstormports/wordpress-sandstorm",
    "package:d6955e8f377ac431db17fd01855b3ce5/read-only-plugins/mu-plugins/sandstorm.php",
    "package:d6955e8f377ac431db17fd01855b3ce5/wordpress-read-only/wp-includes/rest-api.php",
    "package:d6955e8f377ac431db17fd01855b3ce5/wordpress-read-only/wp-includes/rest-api/endpoints/class-wp-rest-posts-controller.php"
  ]
}
