edition ObjectiveBend 1
# The preview scenarios of world/commons: the named scenario (escrow 6 / capacity 5 -> 3, start, late-start
# refusal, completion-only retention, reviewed payout 6), the Gen-1 laws as Boolean functions with closed
# instances, and the negative controls, over the service-commons lifecycle imported qualified. Preview only;
# the lifecycle (ResidentServiceCommons.obend) is the module an app installs and the native route publishes.
import ./NatOrder.obend as Order
import ./ResidentServiceCommons.obend as C

# ---- the named scenario (ServiceCommonsDemonstration.bend) ------------------------
# "escrow 6 / capacity 5 -> 3, start, late-start refusal, completion-only
# retention and reviewed payout 6". Synthetic source values, not physical
# provider receipts. Real receiving instantiates roots and native operation and
# result observations from current signed resources.
#
# Request: 2 units; offer: capacity 5 at rate 3 (amount 6), expires 90; budget 8,
# sponsor cap 8, payer 1 pays escrow account 4 in asset 8 (available 20);
# dispatch deadline 100; provider account 5.

def pin(resource: Nat, root: String) -> C.Pin:
  {resource: resource, root: root}

def method() -> C.Method:
  {artifact: "artifact-1", program: "program-2", exportName: "export-3", inputSchema: "input-4", resultSchema: "result-5"}

def identity() -> C.Identity:
  {request: "request-20", method: method(), input: "input-21", context: "context-22"}

def request(root: String) -> C.Request:
  {identity: identity(), residentHome: pin(10n, root), room: pin(11n, root), consumer: "subject-7", recipient: "subject-7", audience: "audience-8", keyEpoch: "epoch-1", acceptor: "subject-9", criterion: method(), dispatchDeadline: 100n, units: 2n, budget: 8n, payment: {book: 9n, root: root, payer: 1n, escrow: 4n, providerAccount: 5n, asset: 8n, available: 20n}}

def offer(root: String) -> C.Offer:
  {identity: identity(), provider: "provider-6", providerHome: pin(12n, root), capacity: 5n, rate: 3n, expires: 90n, claim: "claim-55"}

def sponsor(root: String, approved: Bool) -> C.Sponsorship:
  {identity: identity(), provider: "provider-6", policy: pin(14n, root), maxAmount: 8n, approved: approved}

def reservation(root: String) -> C.Reservation:
  {request: request(root), offer: offer(root), sponsorship: sponsor(root, true), amount: 6n}

def run(root: String) -> C.Run:
  {identity: "operation-31", requestCell: 17n, sequence: 2n, assignedResident: 7n, operation: "operation-31", activity: pin(13n, root), ordinal: 4n, binding: identity()}

# A second native operation, to try a redispatch with.
def otherRun(root: String) -> C.Run:
  {identity: "operation-32", requestCell: 18n, sequence: 3n, assignedResident: 7n, operation: "operation-32", activity: pin(13n, root), ordinal: 5n, binding: identity()}

def completion(root: String, output: String) -> C.Completion:
  {run: run(root), provider: "provider-6", output: output, recipient: "subject-7", audience: "audience-8", keyEpoch: "epoch-1", receipt: pin(15n, root)}

def review(output: String) -> C.Review:
  {runIdentity: "operation-31", output: output, criterion: method(), reviewer: "subject-9", accepted: true}

# The roots: the book and homes at reservation time, and a fresh admitted
# snapshot (the reservation roots are stale by acceptance time).
def r0() -> String:
  "root-40"

def r1() -> String:
  "root-60"

def held0() -> C.State:
  C.State.held(reservation(r0()))

def running0() -> C.State:
  C.State.running({reservation: reservation(r0()), run: run(r0())})

def uncertain0() -> C.State:
  C.State.uncertain({reservation: reservation(r0()), run: run(r0())})

def delivered0() -> C.State:
  C.State.delivered({reservation: reservation(r0()), run: run(r0()), completion: completion(r0(), "output-41")})

def finished0() -> C.State:
  C.State.finished({reservation: reservation(r0()), run: run(r0()), completion: completion(r0(), "output-41"), review: review("output-41")})

def reserve0() -> C.Transition:
  C.reserve(request(r0()), offer(r0()), sponsor(r0(), true), 80n)

def effectAt(effects: C.Effects, n: Nat) -> C.Effect:
  match effects:
    case none(_): C.Effect.nothing()
    case more(m): effectAtStep(m.head, m.tail, n)

def effectAtStep(head: C.Effect, tail: C.Effects, n: Nat) -> C.Effect:
  match n:
    case 0n: head
    case 1n+q: effectAt(tail, q)

def proposedEffect(t: C.Transition, n: Nat) -> C.Effect:
  match t:
    case refused(_): C.Effect.nothing()
    case proposed(p): effectAt(p.effects, n)

# 1. reserve: escrow 6 and capacity 5 -> 3, with the held state, jointly.
def reservesExactBudgetAndCapacity() -> Bool:
  C.transitionEq(reserve0(), C.proposal(C.State.vacant(), held0(), C.two(C.Effect.money({book: 9n, expectedRoot: r0(), transfer: {source: 1n, destination: 4n, asset: 8n, amount: 6n}}), C.Effect.capacity({home: pin(12n, r0()), before: 5n, after: 3n}))))

def escrowAmount() -> Nat:
  C.moneyOf(proposedEffect(reserve0(), 0n)).transfer.amount

def escrowPayer() -> Nat:
  C.moneyOf(proposedEffect(reserve0(), 0n)).transfer.source

def escrowAccount() -> Nat:
  C.moneyOf(proposedEffect(reserve0(), 0n)).transfer.destination

def capacityBeforeReserve() -> Nat:
  C.capacityOf(proposedEffect(reserve0(), 1n)).before

def capacityAfterReserve() -> Nat:
  C.capacityOf(proposedEffect(reserve0(), 1n)).after

def reserveEffectCount() -> Nat:
  match reserve0():
    case refused(_): 999n
    case proposed(p): C.effectCount(p.effects)

# 2. start: retain the exact pending operation before dispatch.
def retainsBeforeDispatch() -> Bool:
  C.transitionEq(C.start(held0(), run(r0()), 80n), C.proposal(held0(), running0(), C.one(C.Effect.publishRequest({home: pin(10n, r0()), room: pin(11n, r0()), request: request(r0()), run: run(r0())}))))

# 3. late-start refusal: an expired unstarted reservation cannot dispatch.
def expiredUnstartedCannotDispatch() -> Bool:
  C.refusedUnchanged(C.start(held0(), run(r0()), 101n), held0())

def startAtDeadlineAllowed() -> Bool:
  Order.not(C.isRefused(C.start(held0(), run(r0()), 100n)))

# 4. completion-only retention: a true status retains the completion and moves
# no money.
def completionIsNotPayment() -> Bool:
  C.transitionEq(C.resumeAfterStatus(running0(), completion(r0(), "output-41"), true), C.proposal(running0(), delivered0(), C.one(C.Effect.retainCompletion({run: run(r0()), completion: completion(r0(), "output-41")}))))

def completionEffectKind() -> String:
  C.effectKind(proposedEffect(C.resumeAfterStatus(running0(), completion(r0(), "output-41"), true), 0n))

def completionEffectCount() -> Nat:
  match C.resumeAfterStatus(running0(), completion(r0(), "output-41"), true):
    case refused(_): 999n
    case proposed(p): C.effectCount(p.effects)

# 5. reviewed payout 6: money, capacity release 3 -> 5 against a fresh home
# snapshot, and the return commitment, from the delivered state only.
def reviewedResultPaysOnce() -> Bool:
  C.transitionEq(C.accept(delivered0(), review("output-41"), pin(12n, r1()), 3n, r1()), C.proposal(delivered0(), finished0(), C.three(C.Effect.money({book: 9n, expectedRoot: r1(), transfer: {source: 4n, destination: 5n, asset: 8n, amount: 6n}}), C.Effect.capacity({home: pin(12n, r1()), before: 3n, after: 5n}), C.Effect.returnResult({recipient: "subject-7", audience: "audience-8", keyEpoch: "epoch-1", output: "output-41"}))))

def payoutAmount() -> Nat:
  C.moneyOf(proposedEffect(C.accept(delivered0(), review("output-41"), pin(12n, r1()), 3n, r1()), 0n)).transfer.amount

def payoutFrom() -> Nat:
  C.moneyOf(proposedEffect(C.accept(delivered0(), review("output-41"), pin(12n, r1()), 3n, r1()), 0n)).transfer.source

def payoutTo() -> Nat:
  C.moneyOf(proposedEffect(C.accept(delivered0(), review("output-41"), pin(12n, r1()), 3n, r1()), 0n)).transfer.destination

def capacityAfterRelease() -> Nat:
  C.capacityOf(proposedEffect(C.accept(delivered0(), review("output-41"), pin(12n, r1()), 3n, r1()), 1n)).after

# ---- the Gen-1 `law`s, as Boolean functions with closed instances ---------------
# Each is a general statement over every reservation, run and input in Gen-1;
# nothing discharges laws yet, so they are comments + instances here.

# LAW uncertain_keeps_run: uncertain work keeps the exact run and asks to observe
# the existing operation.
def uncertainKeepsRun() -> Bool:
  C.transitionEq(C.uncertain(running0()), C.proposal(running0(), uncertain0(), C.one(C.Effect.awaitExisting(run(r0())))))

# LAW failed_status_retains_uncertainty.
def failedStatusRetainsUncertainty() -> Bool:
  C.transitionEq(C.resumeAfterStatus(running0(), completion(r0(), "output-41"), false), C.proposal(running0(), uncertain0(), C.one(C.Effect.awaitExisting(run(r0())))))

# Observing again keeps the state and the same run.
def uncertainStaysUncertain() -> Bool:
  C.transitionEq(C.uncertain(uncertain0()), C.proposal(uncertain0(), uncertain0(), C.one(C.Effect.awaitExisting(run(r0())))))

# LAW uncertain_cannot_redispatch: no second start of uncertain work, with a
# different run or the same one, early or late.
def uncertainCannotRedispatch() -> Bool:
  C.refusedUnchanged(C.start(uncertain0(), otherRun(r0()), 80n), uncertain0()) && C.refusedUnchanged(C.start(uncertain0(), run(r0()), 80n), uncertain0())

# LAW uncertain_cannot_timeout_refund: elapsed time is not proof of non-execution;
# even the consumer, after the deadline, cannot refund uncertain work.
def uncertainCannotTimeoutRefund() -> Bool:
  C.refusedUnchanged(C.cancel(uncertain0(), "subject-7", 1000n, pin(12n, r1()), 3n, r1()), uncertain0()) && C.refusedUnchanged(C.cancel(running0(), "subject-7", 1000n, pin(12n, r1()), 3n, r1()), running0())

# LAW finished_cannot_pay_twice: a finished request refuses every further
# acceptance, even the identical review.
def finishedCannotPayTwice() -> Bool:
  C.refusedUnchanged(C.accept(finished0(), review("output-41"), pin(12n, r1()), 3n, r1()), finished0())

# LAW sponsor_denial_never_reserves: a denied sponsor cannot reserve, however
# the rest of the request is satisfied.
def sponsorDenialNeverReserves() -> Bool:
  C.refusedUnchanged(C.reserve(request(r0()), offer(r0()), sponsor(r0(), false), 80n), C.State.vacant())

# LAW uncertainty_keeps_activity / delivery_keeps_activity (ServiceCommonsFaces).
def uncertaintyKeepsActivity() -> Bool:
  C.runEq(C.linkedRun(C.activityLink(uncertain0())), run(r0())) && C.hasLink(C.activityLink(uncertain0()))

def deliveryKeepsActivity() -> Bool:
  C.runEq(C.linkedRun(C.activityLink(delivered0())), run(r0())) && C.hasLink(C.activityLink(delivered0()))

def heldHasNoActivityLink() -> Bool:
  C.hasLink(C.activityLink(held0()))

# Further refusals the contract implies.
def deliveredCannotBeDeliveredAgain() -> Bool:
  C.refusedUnchanged(C.deliver(delivered0(), completion(r0(), "output-41")), delivered0())

def completionForOtherProviderRefused() -> Bool:
  C.refusedUnchanged(C.deliver(running0(), {run: run(r0()), provider: "provider-0", output: "output-41", recipient: "subject-7", audience: "audience-8", keyEpoch: "epoch-1", receipt: pin(15n, r0())}), running0())

def completionForOtherRecipientRefused() -> Bool:
  C.refusedUnchanged(C.deliver(running0(), {run: run(r0()), provider: "provider-6", output: "output-41", recipient: "subject-0", audience: "audience-8", keyEpoch: "epoch-1", receipt: pin(15n, r0())}), running0())

def completionForOtherRunRefused() -> Bool:
  C.refusedUnchanged(C.deliver(running0(), {run: otherRun(r0()), provider: "provider-6", output: "output-41", recipient: "subject-7", audience: "audience-8", keyEpoch: "epoch-1", receipt: pin(15n, r0())}), running0())

def completionRetainedFromUncertain() -> Bool:
  C.transitionEq(C.deliver(uncertain0(), completion(r0(), "output-41")), C.proposal(uncertain0(), delivered0(), C.one(C.Effect.retainCompletion({run: run(r0()), completion: completion(r0(), "output-41")}))))

def reviewOfOtherOutputRefused() -> Bool:
  C.refusedUnchanged(C.accept(delivered0(), review("output-99"), pin(12n, r1()), 3n, r1()), delivered0())

def reviewByOtherReviewerRefused() -> Bool:
  C.refusedUnchanged(C.accept(delivered0(), {runIdentity: "operation-31", output: "output-41", criterion: method(), reviewer: "subject-1", accepted: true}, pin(12n, r1()), 3n, r1()), delivered0())

def rejectedReviewRefused() -> Bool:
  C.refusedUnchanged(C.accept(delivered0(), {runIdentity: "operation-31", output: "output-41", criterion: method(), reviewer: "subject-9", accepted: false}, pin(12n, r1()), 3n, r1()), delivered0())

def reviewAgainstOtherHomeRefused() -> Bool:
  C.refusedUnchanged(C.accept(delivered0(), review("output-41"), pin(99n, r1()), 3n, r1()), delivered0())

def acceptOutsideDeliveredRefused() -> Bool:
  C.refusedUnchanged(C.accept(running0(), review("output-41"), pin(12n, r1()), 3n, r1()), running0()) && C.refusedUnchanged(C.accept(held0(), review("output-41"), pin(12n, r1()), 3n, r1()), held0())

# Reservation refusals: capacity, budget, expiry, escrow aliasing, identity.
def reserveRefusedForCapacity() -> Bool:
  C.isRefused(C.reserve(request(r0()), {identity: identity(), provider: "provider-6", providerHome: pin(12n, r0()), capacity: 1n, rate: 3n, expires: 90n, claim: "claim-55"}, sponsor(r0(), true), 80n))

def reserveRefusedForBudget() -> Bool:
  C.isRefused(C.reserve(request(r0()), {identity: identity(), provider: "provider-6", providerHome: pin(12n, r0()), capacity: 5n, rate: 5n, expires: 90n, claim: "claim-55"}, sponsor(r0(), true), 80n))

def reserveRefusedWhenOfferExpired() -> Bool:
  C.isRefused(C.reserve(request(r0()), offer(r0()), sponsor(r0(), true), 91n))

def reserveAllowedAtExpiry() -> Bool:
  Order.not(C.isRefused(C.reserve(request(r0()), offer(r0()), sponsor(r0(), true), 90n)))

def reserveRefusedForOtherIdentity() -> Bool:
  C.isRefused(C.reserve(request(r0()), offer(r0()), {identity: {request: "request-77", method: method(), input: "input-21", context: "context-22"}, provider: "provider-6", policy: pin(14n, r0()), maxAmount: 8n, approved: true}, 80n))

def reserveRefusedForOtherProvider() -> Bool:
  C.isRefused(C.reserve(request(r0()), offer(r0()), {identity: identity(), provider: "provider-0", policy: pin(14n, r0()), maxAmount: 8n, approved: true}, 80n))

def reserveRefusedAboveSponsorCap() -> Bool:
  C.isRefused(C.reserve(request(r0()), offer(r0()), {identity: identity(), provider: "provider-6", policy: pin(14n, r0()), maxAmount: 5n, approved: true}, 80n))

def reserveRefusedForAliasedEscrow() -> Bool:
  C.isRefused(C.reserve({identity: identity(), residentHome: pin(10n, r0()), room: pin(11n, r0()), consumer: "subject-7", recipient: "subject-7", audience: "audience-8", keyEpoch: "epoch-1", acceptor: "subject-9", criterion: method(), dispatchDeadline: 100n, units: 2n, budget: 8n, payment: {book: 9n, root: r0(), payer: 4n, escrow: 4n, providerAccount: 5n, asset: 8n, available: 20n}}, offer(r0()), sponsor(r0(), true), 80n))

def reserveRefusedForThinFunds() -> Bool:
  C.isRefused(C.reserve({identity: identity(), residentHome: pin(10n, r0()), room: pin(11n, r0()), consumer: "subject-7", recipient: "subject-7", audience: "audience-8", keyEpoch: "epoch-1", acceptor: "subject-9", criterion: method(), dispatchDeadline: 100n, units: 2n, budget: 8n, payment: {book: 9n, root: r0(), payer: 1n, escrow: 4n, providerAccount: 5n, asset: 8n, available: 5n}}, offer(r0()), sponsor(r0(), true), 80n))

def reserveRefusedForZeroUnits() -> Bool:
  C.isRefused(C.reserve({identity: identity(), residentHome: pin(10n, r0()), room: pin(11n, r0()), consumer: "subject-7", recipient: "subject-7", audience: "audience-8", keyEpoch: "epoch-1", acceptor: "subject-9", criterion: method(), dispatchDeadline: 100n, units: 0n, budget: 8n, payment: {book: 9n, root: r0(), payer: 1n, escrow: 4n, providerAccount: 5n, asset: 8n, available: 20n}}, offer(r0()), sponsor(r0(), true), 80n))

# Cancel: only an unstarted reservation, by the consumer or after the deadline.
def cancelRefundsEscrow() -> Bool:
  C.transitionEq(C.cancel(held0(), "subject-7", 50n, pin(12n, r1()), 3n, r1()), C.proposal(held0(), C.State.cancelled(reservation(r0())), C.two(C.Effect.money({book: 9n, expectedRoot: r1(), transfer: {source: 4n, destination: 1n, asset: 8n, amount: 6n}}), C.Effect.capacity({home: pin(12n, r1()), before: 3n, after: 5n}))))

def strangerCannotCancelBeforeDeadline() -> Bool:
  C.refusedUnchanged(C.cancel(held0(), "subject-0", 50n, pin(12n, r1()), 3n, r1()), held0())

def strangerMayCancelAfterDeadline() -> Bool:
  Order.not(C.isRefused(C.cancel(held0(), "subject-0", 101n, pin(12n, r1()), 3n, r1())))

# ---- negative controls: the equalities are discriminating (must be false) --------

def transitionEqSeesCapacity() -> Bool:
  C.transitionEq(reserve0(), C.proposal(C.State.vacant(), held0(), C.two(C.Effect.money({book: 9n, expectedRoot: r0(), transfer: {source: 1n, destination: 4n, asset: 8n, amount: 6n}}), C.Effect.capacity({home: pin(12n, r0()), before: 5n, after: 4n}))))

def stateEqSeesRun() -> Bool:
  C.stateEq(running0(), C.State.running({reservation: reservation(r0()), run: otherRun(r0())}))

def stateEqSeesPhase() -> Bool:
  C.stateEq(running0(), uncertain0())

def effectsEqSeesOrder() -> Bool:
  C.effectsEq(C.two(C.Effect.nothing(), C.Effect.awaitExisting(run(r0()))), C.two(C.Effect.awaitExisting(run(r0())), C.Effect.nothing()))
