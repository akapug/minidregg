edition ObjectiveBend 1
# Standing dues: a payer owes a room `amount` every `period` heights, starting at
# `start`, for `periods` periods. Period k is due at `cursorAt(k) = start + k * period`
# and is discharged ONCE, in order, by anyone (a keeper) naming it: a replay names a
# period behind the cursor, a skip names one ahead, and both are refused. A payer who
# is late is caught up one named period per discharge: k overdue periods cost exactly
# k payments, never k + 1. The payer alone may cancel, only inside the notice window
# that opens at a period boundary, never mid-period and never while behind.
#
# Two funding modes. Pay-as-you-go: each discharge proposes one transfer from the
# payer to the room. Prepaid lease (`lease: true`): the payer deposits up front, each
# discharge DRAWS from the deposit (one write: the meter and the draw are the same
# step), a short deposit lapses the lease, and the unspent balance is refunded to the
# payer by `settle`. The lease conserves value: deposited = held + paid + refunded.
#
# Port of Bread's Deos/StandingObligation.lean (cursorAt, cursor_strict_mono,
# replay_rejected, behind_schedule_rejected) and Deos/PrepaidLease.lean (meter and
# draw fused in one write), and of the starbridge-apps/subscription idea of a
# standing grant. Layers, as in world/bounty: (1) pure transitions over an Account;
# (2) the same lifecycle as an Activity that yields one Plan per step. The Plans are
# proposals: a transfer is lowered by the kernel (a seat held by the payer, or the
# lease escrow), never by this program. Preview evidence only; no native receipt
# exists for this package.

record Terms:
  payer: Nat
  room: Nat
  amount: Nat
  period: Nat
  start: Nat
  periods: Nat
  window: Nat
  lease: Bool

sum Phase:
  running: {}
  complete: {}
  cancelled: {}
  lapsed: {}
  void: {}

record Account:
  terms: Terms
  k: Nat
  paid: Nat
  deposited: Nat
  prepaid: Nat
  refunded: Nat
  phase: Phase

record Transfer:
  from: Nat
  to: Nat
  amount: Nat
  escrow: Bool

record Discharge:
  period: Nat
  now: Nat

record Deposit:
  actor: Nat
  amount: Nat

record Notice:
  actor: Nat
  now: Nat

record Tick:
  now: Nat

sum Event:
  discharge: Discharge
  topUp: Deposit
  cancel: Notice
  lapse: Tick
  settle: Tick

record Settled:
  next: Account
  transfer: Transfer

sum Transition:
  refused: Account
  moved: Account
  paid: Settled

# ---- (1) the pure lifecycle -------------------------------------------------

def validTerms(t: Terms) -> Bool:
  0n < t.amount && 0n < t.period && 0n < t.periods && t.payer != t.room && t.window <= t.period

# The due height of period k: the strictly increasing cursor.
def cursorAt(t: Terms, k: Nat) -> Nat:
  t.start + k * t.period

# How many periods are due at `now` (periods 0 .. n-1), never more than the term.
def dueCount(t: Terms, now: Nat) -> Nat:
  if now < t.start then 0n else if t.periods < (now - t.start) / t.period + 1n then t.periods else (now - t.start) / t.period + 1n

def open(t: Terms, deposit: Nat) -> Account:
  if validTerms(t) then {terms: t, k: 0n, paid: 0n, deposited: if t.lease then deposit else 0n, prepaid: if t.lease then deposit else 0n, refunded: 0n, phase: Phase.running()} else {terms: t, k: 0n, paid: 0n, deposited: 0n, prepaid: 0n, refunded: 0n, phase: Phase.void()}

def isRunning(a: Account) -> Bool:
  match a.phase:
    case running(_): true
    case complete(_): false
    case cancelled(_): false
    case lapsed(_): false
    case void(_): false

def phaseName(a: Account) -> String:
  match a.phase:
    case running(_): "running"
    case complete(_): "complete"
    case cancelled(_): "cancelled"
    case lapsed(_): "lapsed"
    case void(_): "void"

# Nothing more can happen: not running and no deposit left to refund.
def finished(a: Account) -> Bool:
  if isRunning(a) then false else a.prepaid == 0n

# How many periods are due and undischarged: what a keeper still owes the room.
def behindBy(a: Account, now: Nat) -> Nat:
  dueCount(a.terms, now) - a.k

# The account after discharging period k: one period, once, from the committed amount.
def advanced(a: Account, drawn: Nat) -> Account:
  {terms: a.terms, k: a.k + 1n, paid: a.paid + a.terms.amount, deposited: a.deposited, prepaid: a.prepaid - drawn, refunded: a.refunded, phase: if a.k + 1n == a.terms.periods then Phase.complete() else Phase.running()}

def payment(a: Account, escrow: Bool) -> Transfer:
  {from: a.terms.payer, to: a.terms.room, amount: a.terms.amount, escrow: escrow}

# A lease draws from its deposit; a short deposit refuses (and may lapse).
def leaseDischarge(a: Account) -> Transition:
  if a.terms.amount <= a.prepaid then Transition.paid({next: advanced(a, a.terms.amount), transfer: payment(a, true)}) else Transition.refused(a)

# The period must be exactly the cursor (a replay names one behind it, a skip one
# ahead), due by now, and inside the term. The payer and payee are the committed
# terms', never the caller's.
def dischargeOn(a: Account, d: Discharge) -> Transition:
  if isRunning(a) && d.period == a.k && a.k < a.terms.periods && cursorAt(a.terms, a.k) <= d.now then (if a.terms.lease then leaseDischarge(a) else Transition.paid({next: advanced(a, 0n), transfer: payment(a, false)})) else Transition.refused(a)

# Only the payer, only into a running lease.
def topUpOn(a: Account, d: Deposit) -> Transition:
  if isRunning(a) && a.terms.lease && d.actor == a.terms.payer && 0n < d.amount then Transition.moved({terms: a.terms, k: a.k, paid: a.paid, deposited: a.deposited + d.amount, prepaid: a.prepaid + d.amount, refunded: a.refunded, phase: a.phase}) else Transition.refused(a)

# The payer alone, inside the notice window of the next unpaid period's boundary:
# `cursorAt(k) <= now < cursorAt(k) + window`, and no earlier period is in arrears.
# Mid-period (the paid period still running) is before the boundary; past the window
# the payer is behind and must catch up before it can leave at the next boundary.
def cancelOn(a: Account, n: Notice) -> Transition:
  if isRunning(a) && n.actor == a.terms.payer && cursorAt(a.terms, a.k) <= n.now && n.now < cursorAt(a.terms, a.k) + a.terms.window && dueCount(a.terms, n.now) <= a.k + 1n then Transition.moved({terms: a.terms, k: a.k, paid: a.paid, deposited: a.deposited, prepaid: a.prepaid, refunded: a.refunded, phase: Phase.cancelled()}) else Transition.refused(a)

# A lease that cannot cover the due period ends; anyone may say so.
def lapseOn(a: Account, k: Tick) -> Transition:
  if isRunning(a) && a.terms.lease && a.k < a.terms.periods && cursorAt(a.terms, a.k) <= k.now && a.prepaid < a.terms.amount then Transition.moved({terms: a.terms, k: a.k, paid: a.paid, deposited: a.deposited, prepaid: a.prepaid, refunded: a.refunded, phase: Phase.lapsed()}) else Transition.refused(a)

# An ended lease returns its unspent balance to the payer, whole, once.
def settleOn(a: Account, k: Tick) -> Transition:
  if isRunning(a) || 0n == a.prepaid then Transition.refused(a) else Transition.paid({next: {terms: a.terms, k: a.k, paid: a.paid, deposited: a.deposited, prepaid: 0n, refunded: a.refunded + a.prepaid, phase: a.phase}, transfer: {from: a.terms.payer, to: a.terms.payer, amount: a.prepaid, escrow: true}})

def react(a: Account, e: Event) -> Transition:
  match e:
    case discharge(d): dischargeOn(a, d)
    case topUp(d): topUpOn(a, d)
    case cancel(n): cancelOn(a, n)
    case lapse(k): lapseOn(a, k)
    case settle(k): settleOn(a, k)

def accountOf(t: Transition) -> Account:
  match t:
    case refused(a): a
    case moved(a): a
    case paid(s): s.next

def wasRefused(t: Transition) -> Bool:
  match t:
    case refused(_): true
    case moved(_): false
    case paid(_): false

def transferAmount(t: Transition) -> Nat:
  match t:
    case refused(_): 0n
    case moved(_): 0n
    case paid(s): s.transfer.amount

def transferFrom(t: Transition) -> Nat:
  match t:
    case refused(_): 0n
    case moved(_): 0n
    case paid(s): s.transfer.from

def transferTo(t: Transition) -> Nat:
  match t:
    case refused(_): 0n
    case moved(_): 0n
    case paid(s): s.transfer.to

# The dues law, read from an account: the room has been paid exactly one amount per
# discharged period; a lease conserves value (deposited = held + paid + refunded); a
# running account is inside its term.
def duesLaw(a: Account) -> Bool:
  a.paid == a.k * a.terms.amount && a.k <= a.terms.periods && (if a.terms.lease then a.deposited == a.prepaid + a.paid + a.refunded else a.prepaid == 0n && a.deposited == 0n && a.refunded == 0n)

def movedAtMostOnce(t: Transition, before: Account) -> Bool:
  match t:
    case refused(a): a.k == before.k && a.paid == before.paid
    case moved(a): a.k == before.k && a.paid == before.paid
    case paid(s): s.next.paid + s.next.refunded == before.paid + before.refunded + s.transfer.amount

# A transition keeps the law, moves the cursor by at most one, and a payment moves
# exactly one amount.
def lawPreserved(t: Transition, before: Account) -> Bool:
  duesLaw(accountOf(t)) && accountOf(t).k <= before.k + 1n && movedAtMostOnce(t, before)

# ---- (2) the lifecycle as an Activity on the kernel (Kernel/ObjectiveActivity) ----
# One input value (`Opening`); the response is the kernel's `resumed {outcome, view}`; the
# Plans are the kernel's own: `await {write, on, patience}` for the next event (one decider, the
# keeper, answers with a typed `Event`), and `transfer {to, amount, write}` for a payment, which
# the kernel performs FROM THE ACTIVITY'S PURSE at the yield (the birth deposit funds it) and
# answers `settled` or `refused`. The declared state is the object's ledger (`paid`): a performed
# payment adds its amount there in the same turn; a refused one writes nothing and the period stays
# owed. Every unfolding past a yield costs one admitted turn.

record Opening:
  terms: Terms
  deposit: Nat
  keeper: Nat
  fresh: Bool

record Ledger:
  paid: Nat

sum EditNat:
  keep: {}
  set: Nat
  add: Nat

record Write:
  paid: EditNat

record Ask:
  decider: Nat

record At:
  at: Nat

sum Source:
  reply: Ask
  height: At

record Await:
  write: Write
  on: Source
  patience: Nat

record Pay:
  to: Nat
  amount: Nat
  write: Write

sum Plan:
  await: Await
  transfer: Pay

sum Outcome:
  reply: Event
  settled: {}
  refused: {}
  unknown: {}
  timedOut: {}
  broken: {}
  upgraded: {}

record View:
  version: Nat
  state: Ledger

record Step:
  outcome: Outcome
  view: View

sum Response:
  resumed: Step

record Receipt:
  phase: String
  k: Nat
  paid: Nat
  refunded: Nat

def receiptOf(a: Account) -> Receipt:
  {phase: phaseName(a), k: a.k, paid: a.paid, refunded: a.refunded}

def keepLedger() -> Write:
  {paid: EditNat.keep()}

# The first yield creates the ledger when the object has none (`fresh`); otherwise it keeps it.
def firstWrite(o: Opening) -> Write:
  if o.fresh then {paid: EditNat.set(0n)} else keepLedger()

def serve(o: Opening, a: Account) -> Activity<Plan, Response, Receipt>:
  if finished(a) then receiptOf(a) else await(o, a, keepLedger())

# Wait for the keeper's next event. An await that is not answered (unknown, timed out, broken)
# waits again; the account is unchanged.
def await(o: Opening, a: Account, w: Write) -> Activity<Plan, Response, Receipt>:
  match perform(Plan.await({write: w, on: Source.reply({decider: o.keeper}), patience: 64n})):
    case resumed(s):
      match s.outcome:
        case reply(e): step(o, a, react(a, e))
        case settled(_): serve(o, a)
        case refused(_): serve(o, a)
        case unknown(_): serve(o, a)
        case timedOut(_): serve(o, a)
        case broken(_): serve(o, a)
        case upgraded(_): serve(o, a)

def step(o: Opening, a: Account, t: Transition) -> Activity<Plan, Response, Receipt>:
  match t:
    case refused(unchanged): serve(o, unchanged)
    case moved(next): serve(o, next)
    case paid(s): transfer(o, a, s)

# The payment is a kernel transfer from the purse: performed whole (`settled`, the ledger adds what
# the room was paid) or refused (nothing moves, nothing is written: the period is still owed).
def transfer(o: Opening, a: Account, s: Settled) -> Activity<Plan, Response, Receipt>:
  match perform(Plan.transfer({to: s.transfer.to, amount: s.transfer.amount, write: {paid: EditNat.add(s.next.paid - a.paid)}})):
    case resumed(st):
      match st.outcome:
        case settled(_): serve(o, s.next)
        case refused(_): serve(o, a)
        case reply(_): serve(o, a)
        case unknown(_): serve(o, a)
        case timedOut(_): serve(o, a)
        case broken(_): serve(o, a)
        case upgraded(_): serve(o, a)

def dues(o: Opening) -> Activity<Plan, Response, Receipt>:
  if finished(open(o.terms, o.deposit)) then receiptOf(open(o.terms, o.deposit)) else await(o, open(o.terms, o.deposit), firstWrite(o))
