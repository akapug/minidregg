#!/usr/bin/python3
# J14 stand-in for the upstream `hermes-acp` worker (no Hermes checkout on
# hbox). It runs as /agent/hermes-acp inside the real bwrap launcher under the
# real grain-runtime controller and does what Hermes does for a room resident,
# with no inference of its own:
#   - speaks the ACP JSON-RPC the controller drives (initialize,
#     session/new|load, session/prompt), and reports the MCP tool catalogue it
#     loaded in session/new's `_meta.miniToolCatalogue` (the restricted
#     resident refuses a worker that does not);
#   - starts the MCP server the controller names in mcpServers
#     (`/agent/grain-runtime mcp-stdio /run/mini-grain.sock`);
#   - runs one OpenAI chat-completions tool loop per prompt through the
#     controller's provider gateway (base_url and one-prompt api_key from the
#     generated /workspace/.hermes/config.yaml), streaming, calling each
#     requested tool over MCP and returning its text inside Hermes's
#     untrusted-tool-result wrapper, until the model stops;
#   - streams the model's text back as ACP agent_message_chunk updates and a
#     tool_call update per tool, then answers the prompt with end_turn.
# The user message is the controller's prompt, verbatim (it ends
# "Assignment: {json}"); the deterministic librarian upstream decides only from
# that assignment and from the tool results. Holds no provider key: the gateway and broker do.
import http.client, json, os, sqlite3, subprocess, sys, urllib.parse

PREFIX = "mcp__mini_grain__"

STATE_DB = "/workspace/.hermes/state.db"

def remember(session, prompt_text, stop):
    """Hermes keeps its sessions in HERMES_HOME/state.db; the controller
    fingerprints that file to bind a completed turn. Private to the worker."""
    if not os.path.exists(STATE_DB):
        os.close(os.open(STATE_DB, os.O_CREAT | os.O_WRONLY, 0o600))
    db = sqlite3.connect(STATE_DB)
    db.execute("pragma journal_mode=delete")
    db.execute("create table if not exists turns (session text, prompt text, stop text)")
    db.execute("insert into turns values (?, ?, ?)", (session, prompt_text, stop))
    db.commit(); db.close()
    os.chmod(STATE_DB, 0o600)

def send(message):
    sys.stdout.write(json.dumps(message) + "\n"); sys.stdout.flush()

def note(line):
    with open("/workspace/standin.log", "a") as log:
        log.write(line + "\n")

def profile():
    values, section = {}, None
    for raw in open("/workspace/.hermes/config.yaml"):
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        if not raw.startswith(" "):
            section = raw.split(":", 1)[0].strip()
            continue
        key, _, value = raw.strip().partition(":")
        values[(section, key.strip())] = value.strip()
    return (values[("model", "base_url")], values[("model", "api_key")], values[("model", "default")],
            int(values.get(("agent", "max_iterations"), "6")))

class Mcp:
    def __init__(self, server):
        self.proc = subprocess.Popen([server["command"], *server.get("args", [])],
                                     stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
        self.next = 0
        self.call("initialize", {"protocolVersion": "2025-06-18", "capabilities": {},
                                 "clientInfo": {"name": "j14-hermes-standin", "version": "1"}})
        self.proc.stdin.write(json.dumps({"jsonrpc": "2.0", "method": "notifications/initialized"}) + "\n")
        self.proc.stdin.flush()
        self.tools = self.call("tools/list", {}).get("tools", [])

    def call(self, method, params):
        self.next += 1
        self.proc.stdin.write(json.dumps({"jsonrpc": "2.0", "id": self.next, "method": method, "params": params}) + "\n")
        self.proc.stdin.flush()
        while True:
            line = self.proc.stdout.readline()
            if not line:
                raise RuntimeError("MCP server closed")
            reply = json.loads(line)
            if reply.get("id") == self.next:
                if "error" in reply:
                    raise RuntimeError(json.dumps(reply["error"]))
                return reply.get("result", {})

    def functions(self):
        return [{"type": "function", "function": {"name": PREFIX + t["name"],
                 "description": t.get("description", ""),
                 "parameters": t.get("inputSchema") or {"type": "object"}}} for t in self.tools]

    def invoke(self, name, arguments):
        result = self.call("tools/call", {"name": name[len(PREFIX):] if name.startswith(PREFIX) else name,
                                          "arguments": arguments})
        text = "".join(part.get("text", "") for part in result.get("content", []) if part.get("type") == "text")
        body = json.dumps({"error": text} if result.get("isError") else {"result": text})
        return f'<untrusted_tool_result source="{name}">\n\n{body}\n</untrusted_tool_result>'

def stream(base, key, body):
    url = urllib.parse.urlsplit(base)
    connection = http.client.HTTPConnection(url.hostname, url.port, timeout=900)
    connection.request("POST", url.path.rstrip("/") + "/chat/completions", body=json.dumps(body).encode(),
                       headers={"Authorization": "Bearer " + key, "Content-Type": "application/json"})
    response = connection.getresponse()
    if response.status != 200:
        raise RuntimeError(f"provider HTTP {response.status}: {response.read()[:300]!r}")
    text, calls, finish = "", {}, None
    for raw in response.read().decode("utf-8").splitlines():
        if not raw.startswith("data: ") or raw == "data: [DONE]":
            continue
        chunk = json.loads(raw[6:])
        for choice in chunk.get("choices", []):
            delta = choice.get("delta", {})
            if delta.get("content"):
                text += delta["content"]
            for call in delta.get("tool_calls") or []:
                slot = calls.setdefault(call.get("index", 0), {"id": "", "name": "", "arguments": ""})
                slot["id"] = call.get("id") or slot["id"]
                function = call.get("function", {})
                slot["name"] += function.get("name") or ""
                slot["arguments"] += function.get("arguments") or ""
            finish = choice.get("finish_reason") or finish
    return text, [calls[i] for i in sorted(calls)], finish

def prompt(session, mcp, text):
    base, key, model, iterations = profile()
    # The user turn is the controller's prompt exactly as received, as Hermes
    # sends it: the controller binds the delivered reply to a provider request
    # carrying that exact text (prefix and assignment).
    messages = [{"role": "user", "content": text}]
    for _ in range(iterations):
        reply, calls, finish = stream(base, key, {"model": model, "messages": messages, "max_tokens": 64,
                                                  "stream": True, "stream_options": {"include_usage": True},
                                                  "tools": mcp.functions()})
        note(f"completion finish={finish} calls={len(calls)} text={len(reply)}")
        if reply:
            send({"jsonrpc": "2.0", "method": "session/update", "params": {"sessionId": session,
                  "update": {"sessionUpdate": "agent_message_chunk", "content": {"type": "text", "text": reply}}}})
        if not calls:
            return "end_turn"
        messages.append({"role": "assistant", "content": reply or None, "tool_calls": [
            {"id": c["id"], "type": "function", "function": {"name": c["name"], "arguments": c["arguments"]}}
            for c in calls]})
        for c in calls:
            send({"jsonrpc": "2.0", "method": "session/update", "params": {"sessionId": session,
                  "update": {"sessionUpdate": "tool_call", "toolCallId": c["id"], "title": c["name"],
                             "status": "pending"}}})
            try:
                output = mcp.invoke(c["name"], json.loads(c["arguments"] or "{}"))
            except Exception as error:  # a tool failure is the model's input, as in Hermes
                output = json.dumps({"error": str(error)})
            messages.append({"role": "tool", "tool_call_id": c["id"], "content": output})
    return "max_turn_requests"

mcp = None
session = "j14-standin"
for raw in sys.stdin:
    message = json.loads(raw)
    method, ident = message.get("method"), message.get("id")
    if ident is None:
        continue
    if method == "initialize":
        send({"jsonrpc": "2.0", "id": ident, "result": {"protocolVersion": 1, "agentCapabilities": {"loadSession": True}}})
    elif method in ("session/new", "session/load"):
        servers = message["params"].get("mcpServers") or []
        mcp = Mcp(servers[0])
        names = sorted(PREFIX + t["name"] for t in mcp.tools)
        result = {"_meta": {"miniToolCatalogue": {"type": "mini-hermes-tool-catalogue-v1", "valid": True, "names": names}}}
        if method == "session/new":
            result["sessionId"] = session
        else:
            session = message["params"].get("sessionId", session)
        send({"jsonrpc": "2.0", "id": ident, "result": result})
    elif method == "session/prompt":
        text = "".join(part.get("text", "") for part in message["params"].get("prompt", []))
        try:
            stop = prompt(session, mcp, text)
        except Exception as error:
            note(f"prompt failed: {error}")
            send({"jsonrpc": "2.0", "id": ident, "error": {"code": -32000, "message": str(error)[:500]}})
            continue
        remember(session, text, stop)
        send({"jsonrpc": "2.0", "id": ident, "result": {"stopReason": stop}})
    else:
        send({"jsonrpc": "2.0", "id": ident, "error": {"code": -32601, "message": "method not found"}})
