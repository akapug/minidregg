# The public docuverse snapshot (WEB-SPK-PUBLIC.md §3.2, §5): as uid
# mini-pubread, import what collect-publications delivered, then
#   mini web --read-only --render-static /srv/mini-public --public-origin ORIGIN
# which renders, as files, the documents the public subject may observe and
# flips /srv/mini-public/current. Caddy serves that directory and nothing else
# (deploy/web/Caddyfile.docuverse). This unit has no network: it reaches the
# Host only through the public relay socket (group mini-public), and its
# consent provider reads the Store read-only.
#
# Writable: the output directory, and the reader's own home (its workspace
# custody: every signed read writes an attempt under the workspace, and the
# consent resident keeps its PID file and socket under ~/.mini). Nothing else.
#
# Period: mini-pubread.timer, set from the render cost in deploy/web/README.md.
[Unit]
Description=Mini public docuverse: render the static snapshot as the public reader
Requires=mini-pubread-collect.service
After=mini-pubread-collect.service mini-store.service
ConditionPathExists=/var/lib/mini-pubread/workspace/workspace.json

[Service]
Type=oneshot
User=mini-pubread
Group=mini-pubread
SupplementaryGroups=mini-public
Slice=mini.slice
Nice=10
# The snapshot is world-readable by design (D8); render-static also sets
# 0644/0755 on what it writes.
UMask=0022
Environment=HOME=/var/lib/mini-pubread
Environment=MINI=/usr/local/bin/mini
Environment=PUBREAD_WS=/var/lib/mini-pubread/workspace
Environment=PUBREAD_INBOX=/var/lib/mini-pubread/inbox
Environment=PUBLIC_ORIGIN=https://demo.dregg.online
ExecStartPre=/usr/local/lib/mini/web/import-publications.sh
ExecStart=/bin/sh -c 'exec "$MINI" web --dir "$PUBREAD_WS" --read-only --render-static /srv/mini-public --public-origin "$PUBLIC_ORIGIN"'
RuntimeMaxSec=30min
MemoryMax=1G
CPUQuota=100%
TasksMax=64
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/mini-public /var/lib/mini-pubread
# The consent provider replays the Store; it must not write it.
ReadOnlyPaths=/var/lib/mini/store
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
