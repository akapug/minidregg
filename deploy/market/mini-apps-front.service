# /etc/systemd/system/mini-apps-front.service — the grain entrance (docs/APP-MARKET-2026-10-27.md §5).
# Caddy proxies every *.demo.dregg.online request to 127.0.0.1:8799 (8797 is the web gateway); the front selects the grain by
# Host and the participant route by the credential presented, then pumps bytes to that route's
# custodian socket, handed over by the worker's edge connector (SCM_RIGHTS). It terminates no TLS, holds no key,
# reaches no Mini socket and adds no authorization; the custodian keeps every check.
[Unit]
Description=Mini app market: the grain entrance behind Caddy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mini-apps-edge
Group=mini-edge
Slice=mini.slice
UMask=0077
ExecStart=/var/lib/mini/candidate/current/bin/mini apps-front --listen 127.0.0.1:8799 --origins /var/lib/mini-apps/origins --domain demo.dregg.online
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_INET AF_UNIX
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
# The front writes no file. It reaches a grain's custodian socket through the worker's edge
# connector /var/lib/mini-apps/edge.sock (0660 mini-core:mini-edge): connect() on a read-only mount works.
ReadOnlyPaths=/var/lib/mini-apps/origins
SupplementaryGroups=mini-edge
InaccessiblePaths=-/run/user -/run/dbus -/etc/mini -/var/lib/mini-keys -/var/lib/mini/sessions -/var/lib/mini/store -/var/lib/mini/credentials -/var/lib/mini-backups -/var/lib/mini-door-process -/var/lib/mini-discord -/var/lib/mini-core -/var/lib/mini-market -/var/lib/mini-apps/guests -/var/lib/mini-apps/requests
MemoryMax=256M
TasksMax=1100

[Install]
WantedBy=multi-user.target
