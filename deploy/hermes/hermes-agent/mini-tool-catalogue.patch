+# Mini's sandbox toolsets: the only built-in toolsets a restricted resident
+# may load, with the exact tool names each adds (upstream toolsets.py at this
+# pin). The controller grants a subset per prompt in
+# HERMES_MINI_SANDBOX_TOOLSETS and checks the reported names exactly.
+_MINI_SANDBOX_TOOLSETS = {
+    "file": ("read_file", "write_file", "patch", "search_files"),
+    "terminal": ("terminal", "process_manage"),
+    "code_execution": ("execute_code",),
+}
+
+
+def _mini_sandbox_toolsets():
+    granted = os.environ.get("HERMES_MINI_SANDBOX_TOOLSETS", "")
+    return [t for t in _MINI_SANDBOX_TOOLSETS if t in granted.split(",")]
+
+
+def _mini_sandbox_tool_names():
+    return {n for t in _mini_sandbox_toolsets() for n in _MINI_SANDBOX_TOOLSETS[t]}
+
 
