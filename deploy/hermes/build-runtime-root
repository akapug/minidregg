#!/usr/bin/env bash
# build-runtime-root SOURCE OUT GRAIN_RUNTIME GRAIN_PROVIDER_BRIDGE
#
# Stage the nonsecret Hermes worker runtime root the bwrap launcher mounts at
# /agent: upstream Hermes Agent (Nous Research) with its ACP extra in a venv,
# Mini's tool-catalogue patch (hermes-agent/mini-tool-catalogue.patch: the
# restricted room resident admits a session only when Hermes reports the exact
# Mini MCP tool surface it loaded), the keyless grain-runtime the worker runs
# as its MCP server, grain-provider-bridge, and the /agent/hermes-acp
# entrypoint. SOURCE is a hermes-agent checkout at HERMES_AGENT_COMMIT (or set
# HERMES_AGENT_COMMIT= to accept SOURCE's HEAD); OUT must not exist. Needs
# python3 (the worker sees the host's /usr read-only) and uv on PATH (or UV).
# Nothing is installed outside OUT; uv's cache lives under OUT.build and is
# removed at the end.
set -euo pipefail
HERMES_AGENT_COMMIT=${HERMES_AGENT_COMMIT-a12c3417c82d9495869962e320b4e73a907e849d}
UV=${UV:-uv}
[[ $# == 4 ]] || { echo 'usage: build-runtime-root SOURCE OUT GRAIN_RUNTIME GRAIN_PROVIDER_BRIDGE' >&2; exit 64; }
src=$(realpath -e -- "$1"); out=$2; runtime=$(realpath -e -- "$3"); bridge=$(realpath -e -- "$4")
here=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
[[ ! -e $out ]] || { echo "build-runtime-root: $out exists" >&2; exit 65; }
if [[ -n $HERMES_AGENT_COMMIT ]]; then
  head=$(git -C "$src" rev-parse HEAD)
  [[ $head == "$HERMES_AGENT_COMMIT" ]] || { echo "build-runtime-root: $src is at $head, not $HERMES_AGENT_COMMIT" >&2; exit 65; }
fi
mkdir -p -m 0755 "$out" "$out.build"
out=$(realpath -e -- "$out")
# The source snapshot: tracked files only (no .git, venvs, builds), then the patch.
git -C "$src" archive --format=tar HEAD | tar -x -C "$out.build" --exclude='tests' --exclude='website' --exclude='evals' --exclude='apps'
mv "$out.build" "$out/source.tmp"; mkdir -m 0700 "$out.build"
patch -d "$out/source.tmp" -p1 --forward --batch <"$here/hermes-agent/mini-tool-catalogue.patch"
mv "$out/source.tmp" "$out/source"
( cd "$out/source" && UV_PROJECT_ENVIRONMENT="$out/venv" UV_CACHE_DIR="$out.build/cache" UV_CONCURRENT_DOWNLOADS=2 \
    UV_CONCURRENT_BUILDS=2 UV_CONCURRENT_INSTALLS=2 \
    "$UV" sync --locked --no-dev --extra acp --python /usr/bin/python3 --no-install-project )
rm -rf -- "$out.build"
install -m 0755 "$runtime" "$out/grain-runtime"
install -m 0755 "$bridge" "$out/grain-provider-bridge"
cat >"$out/hermes-acp" <<'ENTRY'
#!/bin/sh
# Upstream Hermes ACP inside the Mini worker: workspace-private home, no lazy
# installs, the Mini tool catalogue reported on every session response.
export HOME=/workspace HERMES_HOME=/workspace/.hermes PYTHONPATH=/agent/source PYTHONDONTWRITEBYTECODE=1 \
  XDG_CACHE_HOME=/workspace/.cache XDG_CONFIG_HOME=/workspace/.config XDG_DATA_HOME=/workspace/.local/share \
  HERMES_DISABLE_LAZY_INSTALLS=1 HERMES_MINI_TOOL_CATALOGUE=1
exec /agent/venv/bin/python -m acp_adapter.entry "$@"
ENTRY
chmod 0755 "$out/hermes-acp"
chmod -R go-w "$out"
printf 'runtime root %s: hermes-agent %s (+mini-tool-catalogue), pyproject %s, uv.lock %s, grain-runtime %s\n' \
  "$out" "$(git -C "$src" rev-parse HEAD)" "$(sha256sum "$out/source/pyproject.toml" | cut -d' ' -f1)" \
  "$(sha256sum "$out/source/uv.lock" | cut -d' ' -f1)" "$(sha256sum "$out/grain-runtime" | cut -d' ' -f1)"
