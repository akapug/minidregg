#!/bin/sh
# One tick of the PAY watcher (PAY §3.4): a oneshot, run by mini-pay-watcher.timer.
#
#   1. `mini pay watch-config`  the watcher config from the signed pay view (op 107): the
#                               tariff's mint and token program, the ASSIGNED book rows, and
#                               the observer workspace's receipts directory;
#   2. `pay-watcher`            finalized transfers at the endpoints' common tip, written to
#                               STATE/tick/{observations,events}.json;
#   3. retain pending.json      fsynced BEFORE cursor advance, containing observations,
#                               events and cursor states. A restarted tick reuses it.
#                               Below-floor audit events cannot fall through a crash gap;
#   4. `mini pay observe`       ONE report for every record read at this tip, through the
#                               observer's workspace; a decided transfer gets a receipt
#                               (WS/pay/receipts/SIGNATURE.ADDRESS -> the attempt), which is
#                               what step 2 reads next tick.
#   5. self-enrollment          a record at the tariff's enrollment index (PAY §11) is never in
#                               a report: `observe` submits it ALONE through ops 117-120 on the
#                               Host's operator socket under the observer's C_enrol, and the
#                               kernel decides enrol | renew | journal. One decision spends one
#                               tip, so while `observe` prints `enrol-pending`, steps 1-4 run
#                               again (a fresh finalized tip), at most PAY_ENROL_ROUNDS times.
#
#   6. acknowledge             archive the complete tick as STATE/tick/ticks/ID.json after
#                               observe settles (0/3). Existing daily journals stay historical.
#
# Kill it anywhere and the next tick converges (an uncertain submit
# is settled by exact lookup before anything new is sent; a spent nullifier is "already
# credited", never a second credit).
#
# Environment (systemd: EnvironmentFile=/etc/mini/pay/watcher.env and /etc/mini/pay/rpc.env):
#   PAY_OBSERVER_WS          observer workspace (`mini workspace --action init --key
#                            /etc/mini/pay/observer.key --subject OBSERVER --socket ...`)
#   PAY_OBSERVER_CAPABILITY  the observer's genesis capability (genesis `payObserver.capability`)
#   PAY_STATE                watcher state directory (default /var/lib/mini/pay)
#   PAY_RPC_ENDPOINTS        live endpoints, whitespace- or comma-separated (rpc.env; never argv)
#   PAY_RPC_FIXTURES         instead of live endpoints: fixture endpoint directories (rehearsal)
#   PAY_MIN_ENDPOINTS        optional; the watcher's default is 2
#   PAY_WATCH_ENROL          optional, `yes`: watch the enrollment row (PAY §11). Its index and
#                            journal floor are the SIGNED TARIFF's (`mini pay watch-config --enrol
#                            tariff`); the retired PAY_ENROL_INDEX / PAY_JOURNAL_FLOOR are refused
#   PAY_ENROL_CAPABILITY PAY_OPERATOR_SOCKET   optional, together: the observer's genesis
#                            `payObserver.enrolCapability` (C_enrol) and the operator socket of
#                            the same Host (`mini serve --operator-socket`); without them an
#                            enrollment-index record is left undecided (`enrol-unconfigured`)
#   PAY_ENROL_ROUNDS         extra watcher+observe rounds per tick while enrollments wait (default 8)
#   MINI PAY_WATCHER         binaries (default the installed candidate, /var/lib/mini/candidate/current/bin/{mini,pay-watcher})
#
# Exit: the watcher's 2 stops before observation; any pending recovery record stays retained;
# otherwise `mini pay observe`'s status: 0 settled or waiting, 3 a record was quarantined or
# the Host refused, 4 undecided (the next tick looks it up).
#
# Operator verb, when `mini pay observe` cannot settle a pending tick (every later payment waits
# behind it): `mini-pay-watcher --quarantine-tick ID REASON...` moves it whole to
# STATE/tick/quarantine/ID.json; the next tick lists and emits its unreceipted transfers again.
set -eu
umask 077

MINI=${MINI:-/var/lib/mini/candidate/current/bin/mini}
PAY_WATCHER=${PAY_WATCHER:-/var/lib/mini/candidate/current/bin/pay-watcher}
PAY_STATE=${PAY_STATE:-/var/lib/mini/pay}
: "${PAY_OBSERVER_WS:?PAY_OBSERVER_WS is required}"
: "${PAY_OBSERVER_CAPABILITY:?PAY_OBSERVER_CAPABILITY is required}"
command -v jq >/dev/null 2>&1 || { echo 'mini-pay-watcher: jq is required' >&2; exit 2; }
command -v flock >/dev/null 2>&1 || { echo 'mini-pay-watcher: flock is required' >&2; exit 2; }

TICK=$PAY_STATE/tick
mkdir -p "$TICK"
exec 9>"$PAY_STATE/.service.lock"
flock -n 9 || { echo 'mini-pay-watcher: another tick is active' >&2; exit 2; }
if [ "${1:-}" = --quarantine-tick ]; then
  [ $# -ge 3 ] || { echo 'mini-pay-watcher: --quarantine-tick ID REASON...' >&2; exit 64; }
  id=$2; shift 2
  [ -f "$PAY_STATE/watcher.json" ] || { echo 'mini-pay-watcher: no watcher.json yet: nothing to quarantine' >&2; exit 2; }
  exec "$PAY_WATCHER" --config "$PAY_STATE/watcher.json" --out "$TICK" --quarantine-tick "$id" --reason "$*"
fi
if [ -n "${PAY_ENROL_CAPABILITY:-}" ] || [ -n "${PAY_OPERATOR_SOCKET:-}" ]; then
  : "${PAY_ENROL_CAPABILITY:?PAY_ENROL_CAPABILITY and PAY_OPERATOR_SOCKET go together}"
  : "${PAY_OPERATOR_SOCKET:?PAY_ENROL_CAPABILITY and PAY_OPERATOR_SOCKET go together}"
fi
if [ -n "${PAY_ENROL_INDEX:-}" ] || [ -n "${PAY_JOURNAL_FLOOR:-}" ]; then
  echo 'mini-pay-watcher: PAY_ENROL_INDEX/PAY_JOURNAL_FLOOR are retired: the enrollment row and floor come from the signed tariff; set PAY_WATCH_ENROL=yes instead' >&2
  exit 2
fi
case ${PAY_WATCH_ENROL:-} in ''|yes) ;; *) echo 'mini-pay-watcher: PAY_WATCH_ENROL must be yes or unset' >&2; exit 2;; esac
rounds=${PAY_ENROL_ROUNDS:-8}
case $rounds in ''|*[!0-9]*) echo 'mini-pay-watcher: PAY_ENROL_ROUNDS must be an integer' >&2; exit 2;; esac

round() {
  set -- --dir "$PAY_OBSERVER_WS" --out "$PAY_STATE/watcher.json"
  [ -n "${PAY_MIN_ENDPOINTS:-}" ] && set -- "$@" --min-endpoints "$PAY_MIN_ENDPOINTS"
  [ "${PAY_WATCH_ENROL:-}" = yes ] && set -- "$@" --enrol tariff
  "$MINI" pay watch-config "$@" >/dev/null || return $?

  set -- --config "$PAY_STATE/watcher.json" --out "$TICK" --spool "$TICK" --durable-ticks
  if [ -n "${PAY_RPC_FIXTURES:-}" ]; then
    unset PAY_RPC_ENDPOINTS
    for fixture in $PAY_RPC_FIXTURES; do set -- "$@" --rpc-fixture "$fixture"; done
  fi
  watched=0
  "$PAY_WATCHER" "$@" >"$TICK/watcher.stdout" 2>"$TICK/watcher.stderr" || watched=$?
  case $watched in
    0|3) ;;
    *) echo "mini-pay-watcher: pay-watcher exited $watched; nothing submitted: $(tail -1 "$TICK/watcher.stderr")" >&2
       return "$watched" ;;
  esac

  # The complete audit event set is already durable in pending.json before the
  # cursor advances. Archive exactly that immutable bundle after the observer
  # settles; no append-then-marker window can duplicate or lose a journal row.
  tick_id=$(jq -er '.id' "$TICK/pending.json") || return $?
  echo "watcher: $(cat "$TICK/watcher.stdout") exit=$watched tick=$tick_id"
  set -- --dir "$PAY_OBSERVER_WS" --capability "$PAY_OBSERVER_CAPABILITY" --from "$TICK/observations.json"
  if [ -n "${PAY_ENROL_CAPABILITY:-}" ]; then
    set -- "$@" --enrol-capability "$PAY_ENROL_CAPABILITY" --operator-socket "$PAY_OPERATOR_SOCKET"
  fi
  observed=0
  "$MINI" pay observe "$@" >"$TICK/observe.stdout" 2>"$TICK/observe.stderr" || observed=$?
  cat "$TICK/observe.stdout"
  cat "$TICK/observe.stderr" >&2
  case $observed in
    0|3)
      "$PAY_WATCHER" --config "$PAY_STATE/watcher.json" --out "$TICK" --ack-tick "$tick_id" || return $?
      ;;
    *) echo "mini-pay-watcher: observer exited $observed; tick $tick_id remains pending" >&2 ;;
  esac
  return "$observed"
}

tip_slot() { jq -r '.tip.slot' "$TICK/observations.json" 2>/dev/null || echo none; }
status=0
round || status=$?
# A refused report (including tipInvalidOrRegressing) ends this invocation.
# Never enter fresh-tip/enrollment rounds after the observer's refusal.
[ "$status" -eq 0 ] || exit "$status"
last=$(tip_slot)
while [ "$status" -eq 0 ] && [ "$rounds" -gt 0 ] && grep -q '^enrol-pending' "$TICK/observe.stdout" 2>/dev/null; do
  rounds=$((rounds - 1))
  round || status=$?
  now=$(tip_slot)
  [ "$now" != "$last" ] || break
  last=$now
done
exit "$status"
