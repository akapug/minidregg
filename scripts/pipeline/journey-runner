#!/usr/bin/env bash
# scripts/pipeline/journey-runner -- continuous journeys on the journey box (PIPELINE item 4).
#
#   scripts/pipeline/journey-runner [--once] [--tip TIP] [--rows-file PATH (test override)] [--results-root PATH] [--row NAME --source-tree PATH (plant overrides)]
#   scripts/pipeline/journey-runner --version      (this copy's path and sha256; PROTOCOL 7)
#
# SELF-CHECK (PROTOCOL 7; RETRO d: a stale installed copy decided verdicts for ~6-11 h on burst3): the
# runner runs a tip only when it IS that tip's runner: journey-runner, lib.sh and journey-red-lines
# next to this file must be byte-identical to the ones in the tree the rows come from (the tip's lean
# env or source.tar; the --source-tree override when given). Otherwise it prints both sha256s and
# REFUSES (exit 3, TIP/REFUSED, no DONE). The standing service never runs an installed copy: it runs
# the set's own tree's runner (scripts/pipeline/install-journey-units, docs/PIPELINE-HBOX.md).
#
# Every PIPELINE_WATCH_S (60) seconds: for the READY artifact set each label points at (next first,
# then green, then main; mirrored here by the gate box), not yet run, run every row of
# journey-rows (the TIP's own copy when its tree has one) and write $JOURNEY_ROOT/TIP/:
#   results.tsv   ROW<TAB>STATUS<TAB>WALL_S<TAB>OWNER<TAB>DETAIL  (one line per row or sub-row)
#   table.txt     the same, aligned, with the tip, labels and total wall time
#   red.txt       one MERGE-QUEUE line per red row (journey-relay appends them to MERGE-QUEUE.md)
#   rows/<row>/   each row's evidence (stdout/stderr, result json, a red step's logs)
#   DONE          when complete
# The tree a row runs from: the tip's lean env ($ARTIFACT_ROOT/.leanenv/TIP, mirrored with its
# oleans) when present, else source.tar from the set, extracted. Every row gets a fresh SHORT
# scratch directory that is deleted after it (worlds, Stores, sockets, test keys). Owners: the row's
# own hint, else the commit (commits.tsv of the set: commits since the previous green) that
# touched the row's driver files, else "?" (nothing in this batch touched the driver: the red is
# older than the batch, or comes from a dependency the pattern does not name).
set -uo pipefail
PIPELINE_PROG=journey-runner
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
. "$here/lib.sh"
once=0; only=""; rows_override=""; row_override=""; source_override=""
runner_sha() { sha256sum "$1" | cut -c1-16; }
while [ $# -gt 0 ]; do
  case "$1" in --version) printf 'journey-runner %s sha256:%s\n' "$here/journey-runner" "$(runner_sha "$here/journey-runner")"; exit 0 ;;
    --once) once=1; shift ;; --tip) only=$2; once=1; shift 2 ;; --rows-file) rows_override=$(realpath "$2"); shift 2 ;; --results-root) JOURNEY_ROOT=$(realpath -m "$2"); shift 2 ;; --row) row_override=$2; shift 2 ;; --source-tree) source_override=$(realpath "$2"); shift 2 ;; *) pipeline_die "unknown $1" ;; esac
done
mkdir -p "$JOURNEY_ROOT"
exec 7>"$JOURNEY_ROOT/.runner.lock"; flock -n 7 || pipeline_die "another journey-runner holds $JOURNEY_ROOT/.runner.lock"
scratch_base=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}; [ -d "$scratch_base" ] && [ -w "$scratch_base" ] || scratch_base=/tmp

# Product driver input plumbing lives here. Paths belong to this artifact set;
# ancillary inputs have explicit names and no developer-machine defaults.
product_inputs() {
  # One world template per variant per tip (newparticipant-acceptance.sh NEWPARTICIPANT_TEMPLATE_DIR): the
  # first row of a variant builds its world and leaves it; the others restore it. Removed with the tip's run.
  # JOURNEY_WORLD_TEMPLATES=0 builds every world fresh (the before/after wall measurement; a suspected template).
  if [ "${JOURNEY_WORLD_TEMPLATES:-1}" = 0 ]; then export NEWPARTICIPANT_TEMPLATE_DIR=""
  else export NEWPARTICIPANT_TEMPLATE_DIR=$J/world-templates; mkdir -p -m 700 "$NEWPARTICIPANT_TEMPLATE_DIR"; fi
  export HOST=$set/bin/minidregg-host MINI=$set/bin/mini STORE=$set/bin/minidregg-link-sqlite-store
  export VERIFIER=$set/bin/minidregg-credential-signature-verifier SHELL_BIN=$set/bin/mini
  export GRAIN=$set/bin/grain-runtime SPK_HOST_BIN=$set/bin/spk-host PAY_WATCHER_BIN=$set/bin/pay-watcher
  export CANDIDATE=$set/provenance.json
  export M7_REFERENCE=${MINI_M7_REFERENCE:-$(m7_reference_for "$set")}
  export TEST_PROVIDER=${MINI_TEST_PROVIDER_BIN:-$set/fixtures/mini-hermes-test-provider}  # a journey fixture, not a candidate output (package.py --fixture-roles)
  export LAUNCH_GATE=${MINI_LAUNCH_GATE_BIN:-$set/bin/launch-gate}
  export MINI_FN_LAUNCHER=${MINI_FN_LAUNCHER:-} MINI_FN_CORE=${MINI_FN_CORE:-}
}

# M7's reproduction reference (journey.d/m7.sh step 3): another READY set on this box, built by its own
# publish-artifacts run in its own work directory, whose compiled inputs (journey.d/lib/m7-compiled.sh,
# the definition m7.sh compares by) are byte-identical to SET's. The newest such set; none -> empty, and
# the row names M7_REFERENCE missing. MINI_M7_REFERENCE overrides. m7.sh then re-checks everything
# (identical compiled inputs, identical output SHA-256 set, both SHA256SUMS, runtime identity).
m7_reference_for() {  # SET -> a provenance.json path or nothing
  local set=$1 lib=$src/native/resource-client/journey.d/lib/m7-compiled.sh want d
  [ -f "$lib" ] && [ -f "$set/logs/source-files.sha256" ] || return 0
  ( . "$lib"
    want=$(m7_compiled_inputs "$set" | sha256sum) || exit 0
    for d in $(ls -1td "$ARTIFACT_ROOT"/*/READY 2>/dev/null); do
      d=$(dirname "$d")
      [[ $(basename "$d") =~ ^[0-9a-f]{40}$ ]] && [ "$(realpath "$d")" != "$(realpath "$set")" ] || continue
      [ -f "$d/provenance.json" ] && [ -f "$d/logs/source-files.sha256" ] || continue
      [ "$(m7_compiled_inputs "$d" | sha256sum)" = "$want" ] && { echo "$d/provenance.json"; exit 0; }
    done; exit 0 )
}

owner_for() {  # SET ROW SRC -> a lane or commit naming who last changed the row's driver
  local set=$1 row=$2 src=$3 pat
  case "$row" in
    journey|J*|K*|M*) pat='native/resource-client/journey|native/resource-client/journey.d/' ;;
    objective) pat='objective-native|Host/Objective|tests/objective-native' ;;
    rooms|JPRIV*) pat='rooms-e2e|jpriv' ;;
    activity) pat='activity' ;;
    seats|*SEAT*) pat='[Ss]eat' ;;
    *) pat="$row" ;;
  esac
  [ -f "$set/commits.tsv" ] || { echo unknown; return; }
  awk -F'\t' -v p="$pat" '$3 ~ p {print substr($1,1,12)" "substr($2,1,60); exit}' "$set/commits.tsv" | grep . || echo "?"
}

# column(1) is util-linux/bsdextra and absent on the burst2 boxes (no sudo to install it): align with python3 there.
tabalign() {
  if command -v column >/dev/null 2>&1; then column -t -s $'\t'; else
    python3 -c 'import sys
rows=[l.rstrip("\n").split("\t") for l in sys.stdin]
w=[max(len(r[i]) for r in rows if i<len(r)) for i in range(max(map(len,rows)))] if rows else []
for r in rows: print("  ".join(c.ljust(w[i]) for i,c in enumerate(r)).rstrip())'
  fi
}

run_row() {  # ROW: one row in its own scratch world and scope; its lines go to rows/ROW/result.tsv
  local row=$1 O=$J/rows/$1 R s rc st detail owner res scope_result=
  mkdir -p "$O"; res=$O/result.tsv; : >"$res"; R=$(mktemp -d "$scratch_base/pj.XXXXXX"); s=$(date +%s)
  # Each row runs in its own transient scope: when it ends, everything it started (servers a
  # hook forgot, setsid'd children) is stopped with it, by cgroup, not by matching command lines.
  local unit=pj-$row-$(basename "$R" | tr -cd 'A-Za-z0-9')
  product_inputs
  # A row's consent anchors and resident providers live in its scratch world, never
  # under the runner's real HOME (~/.mini/consent-anchors): client_consent.rs anchor_dir.
  export MINI_CONSENT_ANCHOR_DIR=$R/consent-anchors
  if ! command -v systemd-run >/dev/null 2>&1 || ! systemctl --user show-environment >/dev/null 2>&1; then
    echo "no systemd user session" >"$O/row.err"; rc=98
  else
  SRC=$src SET=$set BIN=$set/bin MANIFEST=$set/manifest.json RUN=$R OUT=$O LEANENV=$leanenv ROWSFILE=$rowsfile ROW=$row \
    systemd-run --user --scope --quiet --unit="$unit" -p MemoryMax="${PIPELINE_ROW_MEM_MAX:-24G}" -p MemorySwapMax=0 \
      --setenv=SRC --setenv=SET --setenv=BIN --setenv=MANIFEST --setenv=RUN --setenv=OUT --setenv=LEANENV \
      --setenv=NEWPARTICIPANT_TEMPLATE_DIR \
      -- timeout "${PIPELINE_ROW_TIMEOUT_S:-5400}" bash -c '. "$ROWSFILE"; cd "$RUN" && "row_$ROW"' 2>"$O/row.err" >"$O/row.out"
  rc=$?
  # Failed scopes can kill the row shell before it emits any verdict. Keep the
  # receiving scope's own result and journal before stopping its remaining children.
  printf '%s\n' "$unit.scope" >"$O/scope-unit"
  systemctl --user show "$unit.scope" -p Result -p MemoryPeak -p MemoryMax -p ControlGroup >"$O/scope.properties" 2>"$O/scope-show.err"
  scope_result=$(sed -n 's/^Result=//p' "$O/scope.properties")
  journalctl --user -u "$unit.scope" --since "@$s" --no-pager -n 30 >"$O/scope.log" 2>"$O/scope-journal.err"
  systemctl --user stop "$unit.scope" 2>/dev/null
  fi
  printf '%s\n' "$rc" >"$O/exit-code"
  case $rc in 0) st=PASS ;; 99) st=ABSENT ;; 98) st=UNCONFIGURED ;; 124) st=FAIL; echo "timed out after ${PIPELINE_ROW_TIMEOUT_S:-5400} s" >>"$O/row.err" ;; *) st=FAIL ;; esac
  if [ "$scope_result" = oom-kill ] || grep -q 'killed by the OOM killer' "$O/scope.log" 2>/dev/null; then st=FAIL; fi
  if [ "$st" = FAIL ]; then
    if [ "$scope_result" = oom-kill ] || grep -q 'killed by the OOM killer' "$O/scope.log" 2>/dev/null; then
      echo "scope OOM-killed (MemoryMax=${PIPELINE_ROW_MEM_MAX:-24G}); exit $rc; evidence: scope.log" >>"$O/row.err"
    elif [ -z "$(awk 'NF {last=$0} END {print last}' "$O/row.err")" ]; then
      echo "row exited $rc without a verdict; evidence: scope.log and driver logs" >>"$O/row.err"
    fi
  fi
  detail=$(tail -1 "$O/row.err" | tr '\t' ' ' | cut -c1-300)
  rm -rf "$R"                                   # the scratch world: Stores, sockets, test keys
  owner=$( [ -s "$O/owner" ] && cat "$O/owner" || owner_for "$set" "$row" "$src")
  if [ -s "$O/subrows.tsv" ]; then
    while IFS=$'\t' read -r id sst wall sdet; do
      local so=$owner
      sdet=${sdet//"$R/j/steps/"/"$O/step-"}   # the scratch run is gone; its red steps' logs were kept here
      [[ $sdet =~ \(lane\ ([A-Za-z0-9_-]+)\) ]] && so="lane ${BASH_REMATCH[1]}"
      [ "$sst" = PASS ] || so=$( [[ $so == lane* ]] && echo "$so" || owner_for "$set" "$id" "$src")
      printf '%s/%s\t%s\t%s\t%s\t%s\n' "$row" "$id" "$sst" "$wall" "$so" "${sdet:0:300}" >>"$res"
    done <"$O/subrows.tsv"
    printf '%s\t%s\t%s\t%s\t%s\n' "$row" "$st" $(( $(date +%s) - s )) "$owner" "$detail" >>"$res"
  else
    printf '%s\t%s\t%s\t%s\t%s\n' "$row" "$st" $(( $(date +%s) - s )) "$owner" "$detail" >>"$res"
  fi
  pipeline_log "  $row $st $(( $(date +%s) - s ))s"
}

run_tip() {
  local tip=$1 set=$ARTIFACT_ROOT/$1 J=$JOURNEY_ROOT/$1 src leanenv=0 keep=0 rowsfile t0 tmp
  pipeline_verify_set "$set"
  # a re-run keeps the earlier run's evidence beside it (TIP.run-<time>), never deletes it first
  [ -e "$J" ] && mv "$J" "$J.run-$(date -u +%Y%m%dT%H%M%SZ)"
  mkdir -p "$J/rows"; t0=$(date +%s)
  labels=$(for l in next green main; do [ "$(readlink "$ARTIFACT_ROOT/$l" 2>/dev/null)" = "$tip" ] && printf '%s ' "$l"; done)
  if [ -f "$ARTIFACT_ROOT/.leanenv/$tip/.pipeline-leanenv-complete" ]; then src=$ARTIFACT_ROOT/.leanenv/$tip; leanenv=1
  elif [ -f "$JOURNEY_ROOT/.trees/$tip.dispatch" ] && [ -d "$JOURNEY_ROOT/.trees/$tip" ]; then
    # The service's own extract of the verified source.tar, at a FIXED path: the box's sudoers rules
    # name journeys/.trees/*/ (m6grain's install-user-world), never a scratch path (cv 01a14736-3181).
    # Read-only and kept: it is the dispatch record's tree.
    src=$JOURNEY_ROOT/.trees/$tip; keep=1
  else tmp=$(mktemp -d "$scratch_base/pjs.XXXXXX"); tar -xf "$set/source.tar" -C "$tmp"; src=$tmp; fi
  if [ -n "$source_override" ]; then
    [ -d "$source_override" ] || pipeline_die "no source override: $source_override"
    [ "$leanenv" = 1 ] || [ "$keep" = 1 ] || rm -rf "$src"
    src=$source_override; leanenv=0
  fi
  # SELF-CHECK: this runner must be the tree's own (header). A tree without a runner predates the
  # pipeline and cannot be checked: refused too, never run by whatever copy happens to be here.
  local f bad=""
  for f in journey-runner lib.sh journey-red-lines; do
    cmp -s "$here/$f" "$src/scripts/pipeline/$f" || bad="$bad $f(here:$(runner_sha "$here/$f") tree:$( [ -f "$src/scripts/pipeline/$f" ] && runner_sha "$src/scripts/pipeline/$f" || echo absent))"
  done
  if [ -n "$bad" ]; then
    pipeline_log "REFUSED tip $tip: this runner ($here) is not the tree's own; differs:$bad. Run $src/scripts/pipeline/journey-runner (the set's tree), never an installed copy" | tee "$J/REFUSED" >&2
    if [ "$leanenv" != 1 ] && [ "$keep" != 1 ] && [ -z "$source_override" ]; then rm -rf "$src"; fi
    return 3
  fi
  rowsfile=$src/scripts/pipeline/journey-rows; [ -f "$rowsfile" ] || rowsfile=$here/journey-rows
  if [ -n "$rows_override" ]; then
    [ -f "$rows_override" ] || pipeline_die "no rows override: $rows_override"
    rowsfile=$rows_override
  fi
  unset JOURNEY_ROWS; . "$rowsfile"
  if [ -n "$row_override" ]; then
    [[ " ${JOURNEY_ROWS[*]} " == *" $row_override "* ]] || pipeline_die "unknown row: $row_override"
    JOURNEY_ROWS=("$row_override")
  fi
  pipeline_log "tip $tip (${labels% }) from $src (lean env: $leanenv); runner $here/journey-runner sha256:$(runner_sha "$here/journey-runner") (self-check: the tree's own); rows: ${JOURNEY_ROWS[*]}"
  : >"$J/results.tsv"
  # Rows are independent (each its own scratch world, sockets, Store and scope): run them in
  # parallel, PIPELINE_JOURNEY_JOBS at a time (default all), and assemble the table in row order.
  local jobs=${PIPELINE_JOURNEY_JOBS:-${#JOURNEY_ROWS[@]}} row
  for row in "${JOURNEY_ROWS[@]}"; do
    while [ "$(jobs -rp | wc -l)" -ge "$jobs" ]; do wait -n; done
    run_row "$row" &
  done
  wait
  for row in "${JOURNEY_ROWS[@]}"; do cat "$J/rows/$row/result.tsv" >>"$J/results.tsv"; done
  if [ "$leanenv" != 1 ] && [ "$keep" != 1 ] && [ -z "$source_override" ]; then rm -rf "$src"; fi
  local wall=$(( $(date +%s) - t0 ))
  { printf 'tip %s  labels: %s\njourney wall %s s on %s (%s CPUs), finished %s; set built %s\n\n' "$tip" "${labels% }" \
      "$wall" "$(hostname)" "$(nproc)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(sed -n 's/.*finished=\([^ ]*\).*/\1/p' "$set/PROVENANCE" 2>/dev/null)"
    { printf 'ROW\tSTATUS\tWALL_S\tOWNER\tDETAIL\n'; cat "$J/results.tsv"; } | tabalign; } >"$J/table.txt"
  bash "$here/journey-red-lines" "$JOURNEY_ROOT" "$tip" "${labels% }" >"$J/red.txt"
  rm -rf "$J/world-templates"                 # the tip's world templates: test keys and Stores, not evidence
  echo "$wall" >"$J/WALL_S"; date -u +%Y-%m-%dT%H:%M:%SZ >"$J/DONE"
  pipeline_log "DONE $tip in ${wall}s: $(awk -F'\t' '{c[$2]++} END {for (k in c) printf "%s=%d ", k, c[k]}' "$J/results.tsv")"
  # lean envs: drop those already run and no longer labelled, but keep the newest run one (the
  # gate links the next copy against it). This box owns its copy of the store.
  local keep=" $(for l in next green main; do readlink "$ARTIFACT_ROOT/$l" 2>/dev/null; done | paste -sd' ') " e n=0
  for e in $(ls -1dt "$ARTIFACT_ROOT"/.leanenv/*/ 2>/dev/null); do
    e=$(basename "$e"); [ -f "$JOURNEY_ROOT/$e/DONE" ] || continue
    n=$((n + 1)); [ $n = 1 ] && continue
    [[ $keep == *" $e "* ]] || rm -rf "$ARTIFACT_ROOT/.leanenv/$e"
  done
}

while :; do
  if [ -n "$only" ]; then
    tip=$(pipeline_full_sha "$only") || exit 1
    run_tip "$tip" || exit $?
  else
    for l in next green main; do
      tip=$(readlink "$ARTIFACT_ROOT/$l" 2>/dev/null) || continue
      [ -f "$ARTIFACT_ROOT/$tip/READY" ] && [ ! -f "$JOURNEY_ROOT/$tip/DONE" ] || continue
      [ ! -f "$JOURNEY_ROOT/$tip/REFUSED" ] || continue   # refused once by name: not retried every minute
      # the gate mirrors the lean env right after the set; give it PIPELINE_LEANENV_WAIT_S (1800)
      if [ ! -f "$ARTIFACT_ROOT/.leanenv/$tip/.pipeline-leanenv-complete" ] &&
         [ $(( $(date +%s) - $(stat -c %Y "$ARTIFACT_ROOT/$tip/READY") )) -lt "${PIPELINE_LEANENV_WAIT_S:-1800}" ]; then
        continue
      fi
      run_tip "$tip"
      break   # re-read labels: next may have moved while this ran
    done
  fi
  [ "$once" = 1 ] && break
  sleep "${PIPELINE_WATCH_S:-60}"
done
