#!/usr/bin/env bash
# scripts/pipeline/install-journey-units [--every MINUTES]  -- the standing journey run as user units.
#
# Writes ~/.config/systemd/user/pipeline-journeys.{service,timer} for the box layout in $PIPELINE_ROOT
# (its box.env names ARTIFACT_ROOT and JOURNEY_ROOT), reloads, and enables the timer (default every 5 min).
#
# PROTOCOL 7 / RETRO d: the service NEVER runs an installed copy of the runner. Its only logic is the
# dispatch below, inline in the unit: pick the first label (next, green, main) whose READY set has no
# DONE/REFUSED run, check the set's SHA256SUMS (source.tar is listed), extract source.tar ONCE into
# $JOURNEY_ROOT/.trees/TIP (read-only), print that tree's journey-runner path + sha256, and exec it with
# --tip TIP, after writing $JOURNEY_ROOT/.trees/TIP.dispatch (tree, runner path + sha256, source.tar sha256)
# for landing.sh's RUN-TREE / SELF-CHECK lines. So each tip's rows, runner, lib.sh and journey-red-lines are that tip's own; a runner with the
# self-check (journey-runner header) also refuses by name if it is ever started from anywhere else.
# The unit records this generator's sha256; re-run it after changing it (it is configuration, not a tool).
set -euo pipefail
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
every=5
while [ $# -gt 0 ]; do case "$1" in --every) every=$2; shift 2 ;; *) echo "install-journey-units: unknown $1" >&2; exit 2 ;; esac; done
[ -n "${PIPELINE_ROOT:-}" ] && [ -f "$PIPELINE_ROOT/box.env" ] || { echo "install-journey-units: set PIPELINE_ROOT to a layout with box.env" >&2; exit 2; }
PIPELINE_ROOT=$(realpath "$PIPELINE_ROOT")
gen_sha=$(sha256sum "$here/install-journey-units" | cut -c1-16)
U=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
mkdir -p "$U"
# The dispatch, as systemd will run it ($ -> $$ inside the unit; no single quotes or backslashes in it).
dispatch='set -u; . "$PIPELINE_ROOT/box.env"; mkdir -p "$JOURNEY_ROOT/.trees";
for l in next green main; do
  t=$(readlink "$ARTIFACT_ROOT/$l") || continue;
  [ -f "$ARTIFACT_ROOT/$t/READY" ] || continue;
  if [ -f "$JOURNEY_ROOT/$t/DONE" ] || [ -f "$JOURNEY_ROOT/$t/REFUSED" ]; then continue; fi;
  tree=$JOURNEY_ROOT/.trees/$t;
  if [ ! -f "$tree/.complete" ]; then
    chmod -R u+w "$tree" 2>/dev/null; rm -rf "$tree"; mkdir -p "$tree";
    (cd "$ARTIFACT_ROOT/$t" && sha256sum --quiet -c SHA256SUMS) || { echo "dispatch: SHA256SUMS mismatch in $ARTIFACT_ROOT/$t"; exit 1; };
    tar -xf "$ARTIFACT_ROOT/$t/source.tar" -C "$tree" && touch "$tree/.complete" && chmod -R a-w "$tree" || { echo "dispatch: cannot extract $t"; exit 1; };
  fi;
  r=$tree/scripts/pipeline/journey-runner;
  [ -f "$r" ] || { echo "dispatch: $t has no scripts/pipeline/journey-runner in its tree; not run"; exit 1; };
  printf "tip=%s\nlabel=%s\ntree=%s\nrunner=%s\nrunner_sha256=%s\nsource_tar_sha256=%s\ndispatched=%s\n" "$t" "$l" "$tree" "$r" "$(sha256sum "$r" | cut -d" " -f1)" "$(sha256sum "$ARTIFACT_ROOT/$t/source.tar" | cut -d" " -f1)" "$(date -u +%FT%TZ)" > "$JOURNEY_ROOT/.trees/$t.dispatch";
  echo "dispatch: tip $t ($l) runs $r sha256:$(sha256sum "$r" | cut -c1-16) -- the set tree, never an installed copy";
  exec bash "$r" --tip "$t";
done; echo "dispatch: no unrun READY set under $ARTIFACT_ROOT (next green main)"'
esc=${dispatch//\$/\$\$}
esc=${esc//%/%%}
esc=$(printf '%s' "$esc" | tr '\n' ' ')
cat >"$U/pipeline-journeys.service" <<UNIT
# generated by scripts/pipeline/install-journey-units sha256:$gen_sha on $(hostname) at $(date -u +%Y-%m-%dT%H:%M:%SZ)
[Unit]
Description=standing journey run of the newest unrun READY set, from that set's own tree ($PIPELINE_ROOT)

[Service]
Type=oneshot
Environment=PIPELINE_ROOT=$PIPELINE_ROOT
TimeoutStartSec=infinity
ExecStart=/bin/bash -c '$esc'
UNIT
cat >"$U/pipeline-journeys.timer" <<UNIT
# generated by scripts/pipeline/install-journey-units sha256:$gen_sha
[Unit]
Description=kick pipeline-journeys.service every $every min (a running oneshot is not restarted)

[Timer]
OnActiveSec=1min
OnBootSec=5min
OnUnitInactiveSec=${every}min
Persistent=false

[Install]
WantedBy=timers.target
UNIT
systemctl --user daemon-reload
systemctl --user enable --now pipeline-journeys.timer
systemd-analyze --user verify "$U/pipeline-journeys.service" 2>&1 | grep -v '^$' || true
echo "install-journey-units: $U/pipeline-journeys.{service,timer} (every ${every} min); logs: journalctl --user -u pipeline-journeys"
