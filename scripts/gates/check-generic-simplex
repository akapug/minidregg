#!/usr/bin/env bash
# Generic Simplex gate: runs the three pure-kernel agreement programs the merge gate builds
# (exe-roots) and that no gate ran before 2026-10-27, and proves each can go red.
#
#   scripts/gates/check-generic-simplex [BIN_DIR]     (default .lake/build/bin)
#
#   generic-simplex-harness      the recorded 00f711 stall, backoff recovery, idle quiescence, normal
#                                progress, silent-leader fallback, equivocation, crash replay, roster
#   generic-simplex-log-reopen   100 000-frame journals reopened in constant stack; torn tail; checkpoint
#   generic-simplex-load         every operation of a short busy run commits (its timings are printed,
#                                published, never judged: performance is not a gate)
#
# Plants, each red with its recorded message (a plant that passes, or fails another way, is red):
#   harness --plant fixed-timer   the recovery run without backoff (the paper's fixed timer)
#   harness --plant split-tip     replica 1's committed tip is not a prefix of the others'
#   log-reopen --plant flip-byte  one bit flipped in the middle of the delta-frame image
# Not run here: minidregg-four-source-fixture (a four-process mesh with standing replicas and keys;
# its run is the second-node work, not a seconds-long check).
set -uo pipefail
bin=${1:-.lake/build/bin}
for e in generic-simplex-harness generic-simplex-log-reopen generic-simplex-load; do
  [[ -x $bin/$e ]] || { echo "check-generic-simplex: $bin/$e is not executable" >&2; exit 2; }
done
status=0
start=$(date +%s)
pass() {  # NAME EXPECTED-LAST-LINE-PREFIX CMD...
  local name=$1 want=$2 out rc=0; shift 2
  out=$("$@" 2>&1) || rc=$?
  printf '%s\n' "$out" | tail -n 3
  if [[ $rc == 0 && $(printf '%s\n' "$out" | grep -c "^$want") -ge 1 ]]; then echo "RUN $name PASS"
  else echo "RUN $name FAIL rc=$rc (want exit 0 and a line starting '$want')"; status=1; fi
}
plant() {  # NAME EXPECTED-MESSAGE CMD...
  local name=$1 want=$2 out rc=0; shift 2
  out=$("$@" 2>&1) || rc=$?
  if [[ $rc != 0 && $out == *"$want"* ]]; then echo "PLANT $name RED-AS-EXPECTED ($want)"
  else echo "PLANT $name NOT-CAUGHT-AS-RECORDED rc=$rc (want: $want)"; printf '%s\n' "$out" | tail -n 3; status=1; fi
}
pass harness 'PASS GenericSimplex event harness' "$bin/generic-simplex-harness"
pass log-reopen 'PASS checkpoint-then-append' "$bin/generic-simplex-log-reopen"
pass load "${GENERIC_SIMPLEX_LOAD_OPS:-20}"$'\t' "$bin/generic-simplex-load" "${GENERIC_SIMPLEX_LOAD_OPS:-20}" 10
plant fixed-timer 'backoff: pending block never committed' "$bin/generic-simplex-harness" --plant fixed-timer
plant split-tip 'normal safety/replay' "$bin/generic-simplex-harness" --plant split-tip
plant flip-byte 'delta-frames: ' "$bin/generic-simplex-log-reopen" --plant flip-byte
echo "GENERIC-SIMPLEX wall=$(( $(date +%s) - start ))s status=$status"
exit $status
